<Page x:Class="OmenSuperHub.Pages.NetworkBoostPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:app="clr-namespace:OmenSuperHub"
      Title="{x:Static app:Strings.PageNetworkBoost}">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
      <TextBlock Text="{x:Static app:Strings.PageNetworkBoost}" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>
      <ui:Button x:Name="GotoRulesBtn" Content="{x:Static app:Strings.SidebarRoutingRules}"
                 Click="GotoRulesBtn_Click" Appearance="Secondary" HorizontalAlignment="Right" Margin="0,-40,0,0"/>

      <!-- 运行模式 + 启动 -->
      <ui:CardControl Margin="{StaticResource CardMargin}">
        <ui:CardControl.Header>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="PlugConnected24" FontSize="{DynamicResource FontSizeHeader}" Margin="0,0,8,0"/>
                <TextBlock Text="{x:Static app:Strings.BoostModeHeading}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{DynamicResource AccentOmenBrush}" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Text="{x:Static app:Strings.BoostModeDesc}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <ComboBox x:Name="ModeCombo" Width="220" SelectionChanged="ModeCombo_SelectionChanged">
                  <ComboBoxItem Tag="proxy" Content="{x:Static app:Strings.BoostModeProxy}"/>
                  <ComboBoxItem Tag="tun" Content="{x:Static app:Strings.BoostModeTun}"/>
                </ComboBox>
                <ui:Button x:Name="StartBtn" Margin="12,0,0,0" Content="{x:Static app:Strings.BoostStart}"
                           Click="StartBtn_Click" Appearance="Primary"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"
                         Fill="{DynamicResource TextFillColorDisabledBrush}"/>
                <TextBlock x:Name="StatusText" Text="{x:Static app:Strings.BoostStatusStopped}" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </ui:CardControl.Header>
      </ui:CardControl>

      <!-- 网卡选择 -->
      <ui:CardControl Margin="{StaticResource CardMargin}">
        <ui:CardControl.Header>
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="NetworkAdapter16" FontSize="{DynamicResource FontSizeHeader}" Margin="0,0,8,0"/>
                  <TextBlock Text="{x:Static app:Strings.BoostNicHeading}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{DynamicResource AccentOmenBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{x:Static app:Strings.BoostNicDesc}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="SelectAllBtn" Content="{x:Static app:Strings.BoostSelectAll}" Click="SelectAllBtn_Click" Appearance="Secondary"/>
                <ui:Button x:Name="ClearBtn" Content="{x:Static app:Strings.BoostClearAll}" Margin="8,0,0,0" Click="ClearBtn_Click" Appearance="Secondary"/>
                <ui:Button x:Name="RefreshBtn" Content="{x:Static app:Strings.BoostRefresh}" Margin="8,0,0,0" Click="RefreshBtn_Click" Appearance="Secondary"/>
              </StackPanel>
            </Grid>
            <StackPanel x:Name="NicListPanel" Margin="0,12,0,0"/>
          </StackPanel>
        </ui:CardControl.Header>
      </ui:CardControl>

      <!-- 限速设置 -->
      <ui:CardControl Margin="{StaticResource CardMargin}">
        <ui:CardControl.Header>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Gauge24" FontSize="{DynamicResource FontSizeHeader}" Margin="0,0,8,0"/>
              <TextBlock Text="{x:Static app:Strings.BoostLimitHeading}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{DynamicResource AccentOmenBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{x:Static app:Strings.BoostLimitDesc}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{x:Static app:Strings.BoostLimitGlobal}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal">
                  <ui:TextBox x:Name="GlobalLimitBox" Width="120" PlaceholderText="0"/>
                  <TextBlock Text="KB/s" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{x:Static app:Strings.BoostLimitNic}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal">
                  <ui:TextBox x:Name="NicLimitBox" Width="120" PlaceholderText="0"/>
                  <TextBlock Text="KB/s" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
              </StackPanel>
            </Grid>
          </StackPanel>
        </ui:CardControl.Header>
      </ui:CardControl>

      <!-- 实时状态 -->
      <ui:CardControl>
        <ui:CardControl.Header>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="DataTrending24" FontSize="{DynamicResource FontSizeHeader}" Margin="0,0,8,0"/>
              <TextBlock Text="{x:Static app:Strings.BoostTelemetryHeading}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{DynamicResource AccentOmenBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{x:Static app:Strings.BoostTelemetryDesc}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="TotalDownText" Text="0.0" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource AccentGreenBrush}"/>
                <TextBlock Text="{x:Static app:Strings.BoostDown}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                <TextBlock x:Name="TotalUpText" Text="0.0" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource AccentYellowBrush}"/>
                <TextBlock Text="{x:Static app:Strings.BoostUp}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                <TextBlock x:Name="TotalConnText" Text="0" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource AccentOmenBrush}"/>
                <TextBlock Text="{x:Static app:Strings.BoostConnections}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>
            </Grid>
            <TextBox x:Name="LogBox" IsReadOnly="True" Height="96" Margin="0,14,0,0"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="{DynamicResource FontSizeCaption}"/>
          </StackPanel>
        </ui:CardControl.Header>
      </ui:CardControl>

    </StackPanel>
  </ScrollViewer>
</Page>
