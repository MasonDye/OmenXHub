<ui:FluentWindow x:Class="OmenSuperHub.Pages.CpuOcDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:app="clr-namespace:OmenSuperHub"
        Title="{x:Static app:Strings.CpuOcDialogTitle}"
        Width="600"
        Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16">
        <!-- ExtendsContentIntoTitleBar 模式下系统标题不显示,标题行自绘(对齐 ProcessSelectDialog) -->
        <TextBlock Text="{x:Static app:Strings.CpuOcDialogTitle}" FontSize="{DynamicResource FontSizeTitle}"
                   FontWeight="SemiBold" Margin="0,0,0,12"/>
        <Border x:Name="StatusBorder" Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                CornerRadius="4" Padding="12" Margin="0,0,0,16">
          <TextBlock x:Name="StatusText" Text="{x:Static app:Strings.CpuOcStatusDetecting}" TextWrapping="Wrap"/>
        </Border>

        <TextBlock Text="{x:Static app:Strings.CpuOcCoreRatioHeader}" FontWeight="SemiBold"
                   FontSize="{DynamicResource FontSizeSubheader}" Margin="0,0,0,8"/>
        <ItemsControl x:Name="CoreRatioItems">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="100"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}"
                        Value="{Binding Value, Mode=TwoWay}"
                        TickFrequency="1" IsSnapToTickEnabled="True" Margin="12,0,12,0"/>
                <TextBox Grid.Column="2" Text="{Binding Value, Mode=TwoWay}" TextAlignment="Center" VerticalContentAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Separator Margin="0,16"/>

        <TextBlock Text="{x:Static app:Strings.CpuOcVoltageHeader}" FontWeight="SemiBold"
                   FontSize="{DynamicResource FontSizeSubheader}" Margin="0,0,0,8"/>
        <Grid Margin="0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="80"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="{x:Static app:Strings.CpuOcCoreLabel}" VerticalAlignment="Center"/>
          <Slider x:Name="VoltageOffsetSlider" Grid.Column="1" Minimum="-100" Maximum="100" Value="0"
                  TickFrequency="5" IsSnapToTickEnabled="True" Margin="12,0,12,0"/>
          <TextBox x:Name="VoltageOffsetNum" Grid.Column="2" Text="0" TextAlignment="Center" VerticalContentAlignment="Center"/>
        </Grid>

        <TextBlock Text="{x:Static app:Strings.CpuOcWarning}"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   FontSize="{DynamicResource FontSizeCaption}" Margin="0,16,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16">
      <Button Content="{x:Static app:Strings.ButtonApply}" Width="80" Margin="0,0,8,0" Click="ApplyButton_Click"/>
      <Button Content="{x:Static app:Strings.ButtonCancel}" Width="80" Click="CancelButton_Click"/>
    </StackPanel>
  </Grid>
</ui:FluentWindow>
