<Window x:Class="OmenSuperHub.Pages.CpuOcDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="CPU 超频设置"
        Width="600"
        Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16">
        <Border x:Name="StatusBorder" Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" 
                CornerRadius="4" Padding="12" Margin="0,0,0,16">
          <TextBlock x:Name="StatusText" Text="正在检测超频支持..." TextWrapping="Wrap"/>
        </Border>

        <TextBlock Text="核心频率 (倍频)" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
        <ItemsControl x:Name="CoreRatioItems">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="100"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" Minimum="8" Maximum="80" Value="{Binding Value, Mode=TwoWay}"
                        TickFrequency="1" IsSnapToTickEnabled="True" Margin="12,0,12,0"/>
                <TextBox Grid.Column="2" Text="{Binding Value, Mode=TwoWay}" TextAlignment="Center" VerticalContentAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Separator Margin="0,16"/>

        <TextBlock Text="电压偏移 (mV)" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
        <Grid Margin="0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="80"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="CPU 核心" VerticalAlignment="Center"/>
          <Slider x:Name="VoltageOffsetSlider" Grid.Column="1" Minimum="-100" Maximum="100" Value="0"
                  TickFrequency="5" IsSnapToTickEnabled="True" Margin="12,0,12,0"/>
          <TextBox x:Name="VoltageOffsetNum" Grid.Column="2" Text="0" TextAlignment="Center" VerticalContentAlignment="Center"/>
        </Grid>

        <TextBlock Text="⚠️ 警告: 过高的电压或频率可能导致系统不稳定或硬件损坏" 
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" 
                   FontSize="{DynamicResource FontSizeCaption}" Margin="0,16,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16">
      <Button Content="应用" Width="80" Margin="0,0,8,0" Click="ApplyButton_Click"/>
      <Button Content="取消" Width="80" Click="CancelButton_Click"/>
    </StackPanel>
  </Grid>
</Window>

