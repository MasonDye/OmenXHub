<Page x:Class="OmenSuperHub.Pages.RoutingRulesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:app="clr-namespace:OmenSuperHub"
      Title="{x:Static app:Strings.PageRoutingRules}">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
      <!-- 标题行 + 返回按钮 -->
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ui:Button x:Name="BackBtn" Click="BackBtn_Click"
                   Appearance="Secondary" VerticalAlignment="Center" Padding="8,4"
                   ToolTip="{x:Static app:Strings.BoostRulesBack}">
          <ui:SymbolIcon Symbol="ArrowLeft24"/>
        </ui:Button>
        <TextBlock Grid.Column="1" Text="{x:Static app:Strings.PageRoutingRules}"
                   FontSize="22" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
      </Grid>

      <ui:CardControl Margin="{StaticResource CardMargin}">
        <ui:CardControl.Header>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Router24" FontSize="{DynamicResource FontSizeHeader}" Margin="0,0,8,0"/>
              <TextBlock Text="{x:Static app:Strings.BoostRulesHeading}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{DynamicResource AccentOmenBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{x:Static app:Strings.BoostRulesDesc}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,12" TextWrapping="Wrap"/>

            <!-- 快捷添加 -->
            <TextBlock Text="{x:Static app:Strings.BoostRulesQuickAdd}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
            <WrapPanel x:Name="PresetPanel" Margin="0,0,0,12"/>

            <!-- 表头 -->
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="60"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Static app:Strings.BoostRulesProcessHeader}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBlock Grid.Column="2" Text="{x:Static app:Strings.BoostRulesLimitHeader}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <TextBlock Grid.Column="3" Text="{x:Static app:Strings.BoostRulesOutboundHeader}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </Grid>

            <StackPanel x:Name="RulesPanel"/>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <ui:Button x:Name="AddBtn" Content="{x:Static app:Strings.BoostRulesAdd}" Click="AddBtn_Click" Appearance="Secondary"/>
              <ui:Button x:Name="ClearAllBtn" Content="{x:Static app:Strings.BoostRulesClearAll}" Click="ClearAllBtn_Click"
                         Appearance="Secondary" Margin="8,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </ui:CardControl.Header>
      </ui:CardControl>

    </StackPanel>
  </ScrollViewer>
</Page>
