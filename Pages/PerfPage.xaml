<Page x:Class="OmenSuperHub.Pages.PerfPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:app="clr-namespace:OmenSuperHub"
      Title="{x:Static app:Strings.PagePerf}"
      SizeChanged="PerfPage_SizeChanged">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">

      <TextBlock Text="{x:Static app:Strings.PerfControl}" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

      <DockPanel Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" HorizontalAlignment="Left">
	          <TextBlock FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" Text="{x:Static app:Strings.PerfPresetLabel}"/>
          <ComboBox x:Name="cbxPerfPreset" Width="200" Height="36" SelectionChanged="cbxPerfPreset_SelectionChanged"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
	          <TextBlock FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" Text="{x:Static app:Strings.PerfPresetCopyRename}"/>
          <ui:TextBox x:Name="tbxPerfPresetName" Width="200" Height="36"/>
        </StackPanel>
      </DockPanel>

      <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
        <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="{DynamicResource FontSizeSubheader}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBlock Text="{x:Static app:Strings.PerfGroupCpu}" FontSize="{DynamicResource FontSizeSubheader}" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>

      <Grid x:Name="CpuPerfGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:CardExpander Grid.Row="0" Grid.Column="0" Margin="0,0,4,8" x:Name="AmdCpuPowerCard" Visibility="Collapsed"
                         Icon="Power24">
          <ui:CardExpander.Header>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{x:Static app:Strings.AmdCpuPowerHeading}" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Static app:Strings.AmdCpuPowerDesc}" FontSize="{DynamicResource FontSizeBody}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ComboBox x:Name="AmdPptCombo" MinWidth="100" Margin="0,0,8,0"
                          SelectionChanged="AmdPptCombo_SelectionChanged"/>
              </StackPanel>
            </Grid>
          </ui:CardExpander.Header>
          <StackPanel>
            <!-- ponytail: 仅保留 PPT 一组走 WMI；TDC/EDC/Tctl 三组已随高级调教删除（依赖 SMU 服务，本机不可用）。 -->
            <StackPanel Margin="0,0,0,8">
	              <TextBlock Text="{x:Static app:Strings.AmdPptLabel}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,2"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ui:NumberBox x:Name="AmdCpuPptNum" Minimum="8" Maximum="300" SmallChange="1" MaxDecimalPlaces="0" ValueChanged="AmdCpuPptNum_ValueChanged"
                              Value="{Binding ElementName=AmdCpuPptSlider, Path=Value, Mode=TwoWay}"/>
                <Slider x:Name="AmdCpuPptSlider" Grid.Column="1" Minimum="8" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True" Margin="12,0,0,0" VerticalAlignment="Center"/>
              </Grid>
            </StackPanel>
            <TextBlock x:Name="AmdCpuPowerStatus" FontSize="{DynamicResource FontSizeCaption}" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
          </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Grid.Row="0" Grid.Column="1" Margin="4,0,0,8" x:Name="CpuPowerCard"
                         Icon="DeveloperBoard24">
          <ui:CardExpander.Header>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="DeveloperBoard24" Margin="0,0,6,0"/>
                  <TextBlock Text="{x:Static app:Strings.CpuPowerHeading}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{x:Static app:Strings.PerfAdjustCpuPower}" FontSize="{DynamicResource FontSizeBody}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <ComboBox x:Name="CpuPowerCombo" MinWidth="100" Margin="0,0,8,0"
                           SelectionChanged="CpuPower_SelectionChanged"/>
              </StackPanel>
            </Grid>
          </ui:CardExpander.Header>
          <StackPanel>
            <StackPanel Margin="0,0,0,8">
              <TextBlock FontWeight="DemiBold" FontSize="{DynamicResource FontSizeSubtitle}" Margin="0,0,0,4">
                <Run Text="{x:Static app:Strings.CpuPowerPL1}"/><Run Text=":"/>
              </TextBlock>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ui:NumberBox x:Name="CpuPowerPL1Num" Minimum="1" Maximum="254" SmallChange="1"
                              MaxDecimalPlaces="0" ValueChanged="CpuPowerPL1Num_ValueChanged"
                              Value="{Binding ElementName=CpuPowerPL1Slider, Path=Value, Mode=TwoWay}"/>
                <Slider x:Name="CpuPowerPL1Slider" Grid.Column="1" Minimum="1" Maximum="254"
                        TickFrequency="1" IsSnapToTickEnabled="True" Margin="12,0,0,0"
                        VerticalAlignment="Center"/>
              </Grid>
            </StackPanel>
            <StackPanel>
              <TextBlock FontWeight="DemiBold" FontSize="{DynamicResource FontSizeSubtitle}" Margin="0,0,0,4">
                <Run Text="{x:Static app:Strings.CpuPowerPL2}"/><Run Text=":"/>
              </TextBlock>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ui:NumberBox x:Name="CpuPowerPL2Num" Minimum="1" Maximum="254" SmallChange="1"
                              MaxDecimalPlaces="0" ValueChanged="CpuPowerPL2Num_ValueChanged"
                              Value="{Binding ElementName=CpuPowerPL2Slider, Path=Value, Mode=TwoWay}"/>
                <Slider x:Name="CpuPowerPL2Slider" Grid.Column="1" Minimum="1" Maximum="254"
                        TickFrequency="1" IsSnapToTickEnabled="True" Margin="12,0,0,0"
                        VerticalAlignment="Center"/>
              </Grid>
            </StackPanel>
          </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Grid.Row="0" Grid.Column="1" Margin="4,0,0,8" x:Name="IccMaxCard"
                         Icon="Gauge24">
          <ui:CardExpander.Header>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{x:Static app:Strings.IccMaxHeading}" FontWeight="SemiBold"/>
	                <TextBlock Text="{x:Static app:Strings.IccMaxDesc}" FontSize="{DynamicResource FontSizeBody}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
              </StackPanel>
              <ComboBox Grid.Column="1" x:Name="IccMaxCombo" MinWidth="100" VerticalAlignment="Top" Margin="0,0,12,0"
                        SelectionChanged="IccMax_Changed"/>
            </Grid>
          </ui:CardExpander.Header>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:NumberBox x:Name="IccMaxNum" Minimum="0" Maximum="255" SmallChange="5"
                          MaxDecimalPlaces="0" ValueChanged="IccMaxNum_ValueChanged"
                          Value="{Binding ElementName=IccMaxSlider, Path=Value, Mode=TwoWay}"/>
            <Slider x:Name="IccMaxSlider" Grid.Column="1" Minimum="0" Maximum="255"
                    IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                    Ticks="0,160,165,170,175,180,185,190,195,200,205,210,215,220,225,230,235,240,245,250,255"
                    Margin="12,0,0,0" VerticalAlignment="Center"/>
          </Grid>
        </ui:CardExpander>
        <ui:CardExpander Grid.Row="0" Grid.Column="2" Margin="4,0,0,8" x:Name="CpuOcCard" Visibility="Collapsed"
                         Icon="Rocket24">
          <ui:CardExpander.Header>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="CPU 超频" FontWeight="SemiBold"/>
                <TextBlock Text="每核频率 / 电压偏移" FontSize="{DynamicResource FontSizeBody}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
              </StackPanel>
              <Button Grid.Column="1" Content="设置" MinWidth="80" Margin="0,0,12,0"
                      Click="CpuOcSettings_Click"/>
            </Grid>
          </ui:CardExpander.Header>
          <StackPanel>
            <TextBlock Text="点击右侧按钮打开超频设置" FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
        </ui:CardExpander>

        <ui:CardControl Grid.Row="1" Grid.Column="0" Margin="0,0,4,8" x:Name="AcLoadLineCard">
          <ui:CardControl.Header>
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Gauge24" Margin="0,0,6,0"/>
                  <TextBlock Text="{x:Static app:Strings.AcLoadLineHeading}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <ComboBox x:Name="AcLoadLineCombo" Grid.Column="1" MinWidth="100" VerticalAlignment="Top" Margin="0,0,12,0"
                        SelectionChanged="AcLoadLine_Changed"/>
              </Grid>
              <TextBlock Text="{x:Static app:Strings.AcLoadLineDesc}" FontSize="{DynamicResource FontSizeBody}"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>
          </ui:CardControl.Header>
        </ui:CardControl>

        <ui:CardControl Grid.Row="1" Grid.Column="1" Margin="4,0,0,8">
          <ui:CardControl.Header>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Power24" Margin="0,0,6,0"/>
                <TextBlock Text="{x:Static app:Strings.PowerModeHeading}" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
	              <TextBlock Text="{x:Static app:Strings.PowerModeDesc}" FontSize="{DynamicResource FontSizeBody}"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>
          </ui:CardControl.Header>
          <ComboBox x:Name="PowerModeCombo"  Margin="0,8,0,0"
                    SelectionChanged="PowerMode_SelectionChanged"/>
        </ui:CardControl>

        <ui:CardExpander Grid.Row="2" Grid.Column="0" Margin="0,0,4,8" Icon="Power24">
          <ui:CardExpander.Header>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Power24" Margin="0,0,6,0"/>
                  <TextBlock Text="{x:Static app:Strings.PowerPlanHeading}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
	                <TextBlock Text="{x:Static app:Strings.PowerPlanDesc}" FontSize="{DynamicResource FontSizeBody}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
              </StackPanel>
              <ComboBox Grid.Column="1" x:Name="PowerPlanCombo" MinWidth="140" VerticalAlignment="Top" Margin="0,0,12,0"
                        SelectionChanged="PowerPlan_SelectionChanged"/>
            </Grid>
          </ui:CardExpander.Header>
          <StackPanel Margin="0,4,0,0">

            <!-- AC/DC and Processor Class toggles -->
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
	              <TextBlock Grid.Column="0" Text="{x:Static app:Strings.PwrSourceLabel}" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" Margin="0,0,8,0"
		                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
		              <ComboBox Grid.Column="1" x:Name="PwrSourceCombo" MinWidth="120" Margin="0,0,16,0"
		                        SelectionChanged="PwrSourceCombo_SelectionChanged">
		                <ComboBoxItem Content="{x:Static app:Strings.PwrSourceAc}" Tag="AC" IsSelected="True"/>
		                <ComboBoxItem Content="{x:Static app:Strings.PwrSourceDc}" Tag="DC"/>
		              </ComboBox>
		              <TextBlock Grid.Column="2" Text="{x:Static app:Strings.PwrClassLabel}" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" Margin="0,0,8,0"
		                         Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
		              <ComboBox Grid.Column="3" x:Name="PwrClassCombo" MinWidth="140"
		                        SelectionChanged="PwrClassCombo_SelectionChanged">
		                <ComboBoxItem Content="{x:Static app:Strings.PwrClassAll}" Tag="0" IsSelected="True"/>
		                <ComboBoxItem Content="{x:Static app:Strings.PwrClassPcore}" Tag="1"/>
              </ComboBox>
            </Grid>

            <!-- 1. EPP (Energy Performance Preference) -->
            <StackPanel Margin="0,0,0,10">
	              <TextBlock Text="{x:Static app:Strings.EppLabel}" FontWeight="DemiBold" FontSize="{DynamicResource FontSizeSubtitle}" Margin="0,0,0,4"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="EppCombo" MinWidth="180" IsEditable="True" Margin="0,0,8,0"
                          SelectionChanged="EppCombo_SelectionChanged"/>
                <TextBlock x:Name="EppCurrentText" Grid.Column="1" Text="-" FontSize="{DynamicResource FontSizeCaption}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
              </Grid>
	              <TextBlock Text="{x:Static app:Strings.EppHint}" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 2. Processor Performance Boost Mode -->
            <StackPanel Margin="0,0,0,10">
	              <TextBlock Text="{x:Static app:Strings.BoostModeLabel}" FontWeight="DemiBold" FontSize="{DynamicResource FontSizeSubtitle}" Margin="0,0,0,4"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="BoostModeCombo" MinWidth="180" Margin="0,0,8,0"
                          SelectionChanged="BoostModeCombo_SelectionChanged"/>
                <TextBlock x:Name="BoostModeCurrentText" Grid.Column="1" Text="-" FontSize="{DynamicResource FontSizeCaption}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
              </Grid>
	              <TextBlock Text="{x:Static app:Strings.BoostModeHint}" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 3. Maximum Processor State -->
            <StackPanel Margin="0,0,0,10">
	              <TextBlock Text="{x:Static app:Strings.MaxProcStateLabel}" FontWeight="DemiBold" FontSize="{DynamicResource FontSizeSubtitle}" Margin="0,0,0,4"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="MaxProcStateCombo" MinWidth="180" IsEditable="True" Margin="0,0,8,0"
                          SelectionChanged="MaxProcStateCombo_SelectionChanged"/>
                <TextBlock x:Name="MaxProcStateCurrentText" Grid.Column="1" Text="-" FontSize="{DynamicResource FontSizeCaption}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
              </Grid>
	              <TextBlock Text="{x:Static app:Strings.MaxProcStateHint}" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 4. Minimum Processor State -->
            <StackPanel Margin="0,0,0,10">
              <TextBlock Text="{x:Static app:Strings.MinProcStateLabel}" FontWeight="DemiBold" FontSize="{DynamicResource FontSizeSubtitle}" Margin="0,0,0,4"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="MinProcStateCombo" MinWidth="180" IsEditable="True" Margin="0,0,8,0"
                          SelectionChanged="MinProcStateCombo_SelectionChanged"/>
                <TextBlock x:Name="MinProcStateCurrentText" Grid.Column="1" Text="-" FontSize="{DynamicResource FontSizeCaption}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
              </Grid>
              <TextBlock Text="{x:Static app:Strings.MinProcStateHint}" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 5. Maximum Processor Frequency -->
            <StackPanel Margin="0,0,0,10">
	              <TextBlock Text="{x:Static app:Strings.MaxFreqLabel}" FontWeight="DemiBold" FontSize="{DynamicResource FontSizeSubtitle}" Margin="0,0,0,4"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="MaxFreqCombo" MinWidth="180" IsEditable="True" Margin="0,0,8,0"
                          SelectionChanged="MaxFreqCombo_SelectionChanged"/>
                <TextBlock x:Name="MaxFreqCurrentText" Grid.Column="1" Text="-" FontSize="{DynamicResource FontSizeCaption}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
              </Grid>
	              <TextBlock Text="{x:Static app:Strings.MaxFreqHint}" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 6. SMT Thread Unpark Policy -->
            <StackPanel Margin="0,0,0,10">
	              <TextBlock Text="{x:Static app:Strings.SmtPolicyLabel}" FontWeight="DemiBold" FontSize="{DynamicResource FontSizeSubtitle}" Margin="0,0,0,4"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="SmtPolicyCombo" MinWidth="180" Margin="0,0,8,0"
                          SelectionChanged="SmtPolicyCombo_SelectionChanged"/>
                <TextBlock x:Name="SmtPolicyCurrentText" Grid.Column="1" Text="-" FontSize="{DynamicResource FontSizeCaption}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
              </Grid>
	              <TextBlock Text="{x:Static app:Strings.SmtPolicyHint}" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Action buttons -->
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="PwrPlanStatus" Grid.Column="0" Text="" FontSize="{DynamicResource FontSizeCaption}" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
	              <ui:Button Grid.Column="1" Content="{x:Static app:Strings.ButtonView}" MinWidth="80" Margin="0,0,8,0"
		                         Appearance="Secondary" Click="PwrPlanView_Click"/>
		              <ui:Button Grid.Column="2" Content="{x:Static app:Strings.ButtonApply}" MinWidth="80"
                         Appearance="Primary" Click="PwrPlanApply_Click"/>
            </Grid>

          </StackPanel>
        </ui:CardExpander>

        <ui:CardExpander Grid.Row="2" Grid.Column="1" Margin="4,0,0,8" x:Name="EcoQosCard"
                         Icon="LeafOne24">
          <ui:CardExpander.Header>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="LeafOne24" Margin="0,0,6,0"/>
                  <TextBlock Text="{x:Static app:Strings.EcoQosHeading}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{x:Static app:Strings.PerfEcoQosDesc}" FontSize="{DynamicResource FontSizeBody}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
              </StackPanel>
              <ui:ToggleSwitch x:Name="EcoQosToggle" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                              Checked="EcoQosToggle_Checked" Unchecked="EcoQosToggle_Unchecked"/>
            </Grid>
          </ui:CardExpander.Header>
          <StackPanel x:Name="EcoQosExtra">
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Static app:Strings.EcoQosThrottlePlugged}" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center"/>
              <ui:ToggleSwitch x:Name="EcoQosThrottlePluggedToggle" Grid.Column="1"
                              Checked="EcoQosThrottlePlugged_Changed" Unchecked="EcoQosThrottlePlugged_Changed"/>
            </Grid>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Static app:Strings.EcoQosWhitelist}" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center"/>
              <ui:Button x:Name="EcoQosWhitelistEdit" Grid.Column="1"
                      MinWidth="60" Height="24" Padding="8,0" Content="{x:Static app:Strings.ButtonEdit}" Click="EcoQosWhitelistEdit_Click" Appearance="Secondary"/>
            </Grid>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{x:Static app:Strings.EcoQosBlacklist}" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center"/>
              <ui:Button x:Name="EcoQosBlacklistEdit" Grid.Column="1"
                      MinWidth="60" Height="24" Padding="8,0" Content="{x:Static app:Strings.ButtonEdit}" Click="EcoQosBlacklistEdit_Click" Appearance="Secondary"/>
            </Grid>
          </StackPanel>
        </ui:CardExpander>

        <!-- 异构调度 (AMD 双CCD 模拟大小核) -->
        <ui:CardExpander Grid.Row="3" Grid.ColumnSpan="2" Margin="{StaticResource CardMargin}" x:Name="HeteroCpuCard"
                         Icon="DeviceEq24">
          <ui:CardExpander.Header>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="DeviceEq24" Margin="0,0,6,0"/>
                  <TextBlock Text="{x:Static app:Strings.HeteroCpuHeading}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{x:Static app:Strings.HeteroCpuToggleDesc}" FontSize="{DynamicResource FontSizeBody}"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
              </StackPanel>
              <ui:ToggleSwitch x:Name="HeteroCpuToggle" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                              Checked="HeteroCpuToggle_Changed" Unchecked="HeteroCpuToggle_Changed"/>
            </Grid>
          </ui:CardExpander.Header>
          <StackPanel x:Name="HeteroCpuDetails" Visibility="Collapsed">
            <!-- SmallProcessorMask -->
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{x:Static app:Strings.HeteroCpuMaskLabel}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" VerticalAlignment="Center"/>
