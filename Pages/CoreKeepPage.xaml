<Page x:Class="OmenSuperHub.Pages.CoreKeepPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:app="clr-namespace:OmenSuperHub"
      Title="{x:Static app:Strings.PageCoreKeep}">
  <Page.Resources>
    <!-- ponytail: 规则级别颜色标签 — DataTrigger 绑定 EnforcementLevel 字符串值 -->
    <Style x:Key="LevelBadgeBorder" TargetType="Border">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="Background" Value="#330078D4"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding EnforcementLevel}" Value="soft-cpu-sets">
          <Setter Property="Background" Value="#330078D4"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding EnforcementLevel}" Value="hard-affinity">
          <Setter Property="Background" Value="#33FFB900"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding EnforcementLevel}" Value="job-enforced">
          <Setter Property="Background" Value="#33F7630C"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding EnforcementLevel}" Value="job-locked">
          <Setter Property="Background" Value="#33E74856"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LevelBadgeText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#FF0078D4"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding EnforcementLevel}" Value="soft-cpu-sets">
          <Setter Property="Text" Value="提示"/>
          <Setter Property="Foreground" Value="#FF0078D4"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding EnforcementLevel}" Value="hard-affinity">
          <Setter Property="Text" Value="软强制"/>
          <Setter Property="Foreground" Value="#FFFFB900"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding EnforcementLevel}" Value="job-enforced">
          <Setter Property="Text" Value="硬强制"/>
          <Setter Property="Foreground" Value="#FFF7630C"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding EnforcementLevel}" Value="job-locked">
          <Setter Property="Text" Value="锁定"/>
          <Setter Property="Foreground" Value="#FFE74856"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Page.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">

      <!-- 标题行 -->
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ui:Button x:Name="BackToPerfBtn" Click="BackToPerf_Click"
                   Appearance="Secondary" VerticalAlignment="Center" Padding="8,4"
                   ToolTip="{x:Static app:Strings.CoreKeepBackToPerf}">
          <ui:SymbolIcon Symbol="ArrowLeft24"/>
        </ui:Button>
        <TextBlock Grid.Column="1" Text="{x:Static app:Strings.PageCoreKeep}"
                   FontSize="22" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
      </Grid>

      <!-- ══════ 统计概览 ══════ -->
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="6"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="6"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="6"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- 运行进程 -->
        <Border Grid.Column="0" CornerRadius="8" Padding="14,10" Background="{DynamicResource ControlFillColorDefaultBrush}">
          <StackPanel>
            <TextBlock Text="{x:Static app:Strings.CoreKeepStatProcesses}" FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="StatProcessCount" Text="--" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource AccentOmenBrush}"/>
          </StackPanel>
        </Border>
        <!-- 活跃规则 -->
        <Border Grid.Column="2" CornerRadius="8" Padding="14,10" Background="{DynamicResource ControlFillColorDefaultBrush}">
          <StackPanel>
            <TextBlock Text="{x:Static app:Strings.CoreKeepStatRulesActive}" FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="StatRulesCount" Text="--" FontSize="24" FontWeight="Bold"
                       Foreground="#FF107C10"/>
          </StackPanel>
        </Border>
        <!-- P 核 -->
        <Border Grid.Column="4" CornerRadius="8" Padding="14,10" Background="{DynamicResource ControlFillColorDefaultBrush}">
          <StackPanel>
            <TextBlock Text="{x:Static app:Strings.CoreKeepStatPCores}" FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="StatPcoreCount" Text="--" FontSize="24" FontWeight="Bold"
                       Foreground="#FFE74856"/>
          </StackPanel>
        </Border>
        <!-- E 核 -->
        <Border Grid.Column="6" CornerRadius="8" Padding="14,10" Background="{DynamicResource ControlFillColorDefaultBrush}">
          <StackPanel>
            <TextBlock Text="{x:Static app:Strings.CoreKeepStatECores}" FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="StatEcoreCount" Text="--" FontSize="24" FontWeight="Bold"
                       Foreground="#FF0078D4"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- ══════ 1. 主开关 + CPU 拓扑可视化 ══════ -->
      <ui:CardExpander Margin="0,0,0,8" Icon="AppsList24" IsExpanded="True">
        <ui:CardExpander.Header>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="AppsList24" FontSize="{DynamicResource FontSizeHeader}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{x:Static app:Strings.CoreKeepMasterLabel}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentOmenBrush}" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Text="{x:Static app:Strings.CoreKeepMasterDesc}" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
              <TextBlock x:Name="CoreKeepTopologyText" FontSize="{DynamicResource FontSizeCaption}" Margin="0,2,0,0"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
            <ui:ToggleSwitch x:Name="CoreKeepMasterToggle" Grid.Column="1" VerticalAlignment="Center"
                            Checked="CoreKeepMasterToggle_Changed" Unchecked="CoreKeepMasterToggle_Changed"/>
          </Grid>
        </ui:CardExpander.Header>
        <!-- CPU 拓扑核心网格可视化 -->
        <StackPanel Margin="0,8,0,0">
          <TextBlock Text="{x:Static app:Strings.CoreKeepTopologyHeading}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                     Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <ItemsControl x:Name="CoreVisualGrid">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="48" Height="48" CornerRadius="8" Margin="3"
                        Background="{Binding ColorBrush}" ToolTip="{Binding Tooltip}">
                  <TextBlock Text="{Binding Index}" Foreground="White" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="SemiBold"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- 图例 -->
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
              <Border Width="14" Height="14" CornerRadius="3" Background="#FFE74856" Margin="0,0,4,0"/>
              <TextBlock Text="P-Core" FontSize="{DynamicResource FontSizeCaption}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
              <Border Width="14" Height="14" CornerRadius="3" Background="#FF0078D4" Margin="0,0,4,0"/>
              <TextBlock Text="E-Core" FontSize="{DynamicResource FontSizeCaption}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
              <Border Width="14" Height="14" CornerRadius="3" Background="#FF5B6B73" Margin="0,0,4,0"/>
              <TextBlock Text="SMT0" FontSize="{DynamicResource FontSizeCaption}" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Width="14" Height="14" CornerRadius="3" Background="#FF8B95A1" Margin="0,0,4,0"/>
              <TextBlock Text="SMT1" FontSize="{DynamicResource FontSizeCaption}" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </ui:CardExpander>

      <!-- ══════ 2. 进程列表（右键快速操作） ══════ -->
      <ui:CardExpander Margin="0,0,0,8" Icon="List24" IsExpanded="True">
        <ui:CardExpander.Header>
          <StackPanel>
            <TextBlock Text="{x:Static app:Strings.CoreKeepProcessListHeading}" FontWeight="SemiBold"/>
            <TextBlock Text="{x:Static app:Strings.CoreKeepProcessListDesc}" FontSize="{DynamicResource FontSizeBody}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
          </StackPanel>
        </ui:CardExpander.Header>
        <StackPanel>
          <!-- 搜索 + 刷新 -->
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="ProcessSearchBox" PlaceholderText="{x:Static app:Strings.CoreKeepProcessSearch}"
                        TextChanged="ProcessSearch_TextChanged"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
              <CheckBox x:Name="ProcessSortByCpuToggle" Content="{x:Static app:Strings.CoreKeepSortByCpu}" IsChecked="True"
                        Checked="ProcessSortByCpuToggle_Changed" Unchecked="ProcessSortByCpuToggle_Changed"
                        VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ui:Button x:Name="ProcessRefreshBtn" Content="{x:Static app:Strings.CoreKeepProcessRefresh}"
                         Click="ProcessRefresh_Click" Appearance="Secondary"/>
            </StackPanel>
          </Grid>
          <!-- 批量操作折叠面板 (对筛选后全部进程生效) -->
          <Expander x:Name="BatchPanel" Margin="0,0,0,8" IsExpanded="False" Expanded="BatchPanel_Expanded">
            <Expander.Header>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ArrowSort24" FontSize="{DynamicResource FontSizeTitle}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="{x:Static app:Strings.CoreKeepBatchHeading}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="BatchImpactText" FontSize="{DynamicResource FontSizeCaption}" Margin="12,0,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
              </StackPanel>
            </Expander.Header>
            <StackPanel Margin="0,8,0,0">
              <TextBlock Text="{x:Static app:Strings.CoreKeepBatchDesc}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,4"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
              <TextBlock Text="{x:Static app:Strings.CoreKeepBatchNoSelection}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,8"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
              <!-- 模式 + 级别 双列 -->
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{x:Static app:Strings.CoreKeepModeLabel}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,4"
                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <ComboBox x:Name="BatchModeCombo" MinWidth="120"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="{x:Static app:Strings.CoreKeepEnforcementLevelLabel}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,4"
                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <ComboBox x:Name="BatchLevelCombo" MinWidth="120"/>
                </StackPanel>
              </Grid>
              <!-- 全选 + 三个动作按钮 -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ui:Button x:Name="BatchSelectAllBtn" Grid.Column="0"
                           Content="{x:Static app:Strings.CoreKeepBatchSelectAll}"
                           Appearance="Secondary" Click="BatchSelectAll_Click"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                  <ui:Button x:Name="BatchApplyBtn" Content="{x:Static app:Strings.CoreKeepBatchApply}"
                             Appearance="Primary" Click="BatchApply_Click" Margin="0,0,8,0"/>
                  <ui:Button x:Name="BatchRelaxBtn" Content="{x:Static app:Strings.CoreKeepBatchRelax}"
                             Appearance="Secondary" Click="BatchRelax_Click" Margin="0,0,8,0"/>
                  <ui:Button x:Name="BatchAddRulesBtn" Content="{x:Static app:Strings.CoreKeepBatchAddRules}"
                             Appearance="Secondary" Click="BatchAddRules_Click"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Expander>
          <!-- 进程列表 -->
          <ListBox x:Name="ProcessListBox" MaxHeight="300" MinHeight="100"
                   VirtualizingStackPanel.IsVirtualizing="True"
                   VirtualizingStackPanel.VirtualizationMode="Recycling"
                   ScrollViewer.CanContentScroll="True"
                   SelectionMode="Single">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="8,4,18,4"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <!-- 批量勾选框 -->
                  <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                            IsChecked="{Binding IsChecked, Mode=TwoWay}"
                            Click="ProcessCheck_Click"/>
                  <!-- 图标占位 -->
                  <Border Grid.Column="1" Width="32" Height="32" CornerRadius="6" Margin="0,0,10,0"
                          Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <ui:SymbolIcon Symbol="Apps24" FontSize="{DynamicResource FontSizeTitle}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                  </Border>
                  <!-- 名称 + 路径 -->
                  <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding PathText}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <!-- 规则级别标签 -->
                  <Border Grid.Column="3" CornerRadius="8" Padding="6,2" Margin="8,0"
                          Background="{Binding RuleBadgeBrush}"
                          Visibility="{Binding HasRule}">
                    <TextBlock Text="{Binding RuleLevelText}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                               Foreground="{Binding RuleBadgeForeground}"/>
                  </Border>
                  <!-- CPU 占用（两拍差分采样） -->
                  <StackPanel Grid.Column="4" Width="52" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="{Binding CpuText}" FontSize="{DynamicResource FontSizeCaption}" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding ManageLockText}" FontSize="{DynamicResource FontSizeCaption}" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                  </StackPanel>
                  <!-- PID + 亲和性 -->
                  <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right">
                      <Run Text="PID "/><Run Text="{Binding PidText}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding AffinityText}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Right"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
              <ContextMenu x:Name="ProcessContextMenu">
                <MenuItem Header="{x:Static app:Strings.CoreKeepQuickSetPCores}" Click="QuickSetPCores_Click"/>
                <MenuItem Header="{x:Static app:Strings.CoreKeepQuickSetECores}" Click="QuickSetECores_Click"/>
                <MenuItem Header="{x:Static app:Strings.CoreKeepQuickSetAll}" Click="QuickSetAll_Click"/>
                <Separator/>
                <MenuItem Header="{x:Static app:Strings.CoreKeepQuickSetFirstHalf}" Click="QuickSetFirstHalf_Click"/>
                <MenuItem Header="{x:Static app:Strings.CoreKeepQuickSetSecondHalf}" Click="QuickSetSecondHalf_Click"/>
                <Separator/>
                <MenuItem Header="{x:Static app:Strings.CoreKeepQuickJobEnforced}" Click="QuickJobEnforced_Click"/>
                <MenuItem Header="{x:Static app:Strings.CoreKeepQuickJobLocked}" Click="QuickJobLocked_Click"/>
                <Separator/>
                <MenuItem Header="{x:Static app:Strings.CoreKeepQuickRelax}" Click="QuickRelax_Click"/>
                <MenuItem Header="{x:Static app:Strings.CoreKeepQuickApplyRule}" Click="QuickApplyRule_Click"/>
              </ContextMenu>
            </ListBox.ContextMenu>
          </ListBox>
        </StackPanel>
      </ui:CardExpander>

      <!-- ══════ 3. 规则列表（卡片式） + 添加 ══════ -->
      <ui:CardExpander Margin="0,0,0,8" Icon="List24" IsExpanded="True">
        <ui:CardExpander.Header>
          <StackPanel>
            <TextBlock Text="{x:Static app:Strings.CoreKeepHeading}" FontWeight="SemiBold"/>
            <TextBlock Text="{x:Static app:Strings.PerfCoreKeepDesc}" FontSize="{DynamicResource FontSizeBody}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
          </StackPanel>
        </ui:CardExpander.Header>
        <StackPanel>
          <!-- 添加进程输入 -->
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="CoreKeepProcInput" MinWidth="260"
                        PlaceholderText="{x:Static app:Strings.CoreKeepProcInputHint}"
                        VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
              <ui:Button x:Name="CoreKeepAddBtn" Content="{x:Static app:Strings.CoreKeepAddBtn}"
                         Appearance="Primary" Click="CoreKeepAdd_Click" Margin="0,0,8,0"/>
              <ui:Button x:Name="CoreKeepRefreshBtn" Content="{x:Static app:Strings.CoreKeepRefreshBtn}"
                         Click="CoreKeepRefresh_Click" Margin="0,0,8,0" Appearance="Secondary"/>
              <ui:Button x:Name="CoreKeepDeleteBtn" Content="{x:Static app:Strings.CoreKeepDeleteBtn}"
                         Click="CoreKeepDelete_Click" Appearance="Caution"/>
            </StackPanel>
          </Grid>
          <!-- 实时状态行 -->
          <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
            <TextBlock Text="{x:Static app:Strings.CoreKeepPriorityLabel}" VerticalAlignment="Center"
                       Margin="0,0,8,0" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock x:Name="CoreKeepPriorityText" Text=" -" VerticalAlignment="Center"
                       Margin="0,0,16,0" FontSize="{DynamicResource FontSizeBody}"/>
            <TextBlock Text="{x:Static app:Strings.CoreKeepAffinityLabel}" VerticalAlignment="Center"
                       Margin="0,0,8,0" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <TextBlock x:Name="CoreKeepAffinityText" Text=" -" VerticalAlignment="Center"
                       Margin="0,0,16,0" FontSize="{DynamicResource FontSizeBody}"/>
            <TextBlock x:Name="CoreKeepStatusIcon" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="{DynamicResource FontSizeBody}"/>
            <TextBlock x:Name="CoreKeepLivePriorityText" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
          </StackPanel>
          <!-- 规则列表（卡片式） -->
          <ListBox x:Name="CoreKeepList" MinHeight="60" MaxHeight="240"
                   SelectionChanged="CoreKeepList_SelectionChanged">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="6" Padding="12,8"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 启用指示圆点 -->
                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                            VerticalAlignment="Center" Margin="0,0,10,0">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="#665B6B73"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Enabled}" Value="True">
                              <Setter Property="Background" Value="#FF107C10"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                    </Border>
                    <!-- 名称 + 标签 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding ProcessName}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis"/>
                      <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <!-- 模式标签 -->
                        <Border CornerRadius="6" Padding="6,1" Margin="0,0,6,0"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                          <TextBlock Text="{Binding CoreMode}" FontSize="{DynamicResource FontSizeCaption}"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Border>
                        <!-- 级别标签 (DataTrigger 变色) -->
                        <Border Style="{StaticResource LevelBadgeBorder}">
                          <TextBlock Style="{StaticResource LevelBadgeText}"/>
                        </Border>
                      </StackPanel>
                    </StackPanel>
                    <!-- 亲和性掩码 -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                      <TextBlock FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right">
                        <Run Text="0x"/><Run Text="{Binding AffinityMask, StringFormat=X}"/>
                      </TextBlock>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="CoreKeepEmptyHint" Text="{x:Static app:Strings.CoreKeepEmptyList}"
                     FontSize="{DynamicResource FontSizeCaption}" Margin="0,8,0,0"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     Visibility="Collapsed"/>
        </StackPanel>
      </ui:CardExpander>

      <!-- ══════ 4. 规则配置（完整编辑） ══════ -->
      <ui:CardExpander Margin="0,0,0,8" Icon="SettingsAdjustments24" IsExpanded="True">
        <ui:CardExpander.Header>
          <StackPanel>
            <TextBlock Text="{x:Static app:Strings.CoreKeepRuleConfigHeading}" FontWeight="SemiBold"/>
            <TextBlock Text="{x:Static app:Strings.CoreKeepEnforcementLevelHint}" FontSize="{DynamicResource FontSizeCaption}"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </ui:CardExpander.Header>
        <StackPanel>
          <!-- 规则名称 + 启用开关 -->
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{x:Static app:Strings.CoreKeepRuleNameLabel}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,4"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
              <ui:TextBox x:Name="CoreKeepRuleNameInput" MinWidth="200"
                          PlaceholderText="{x:Static app:Strings.CoreKeepRuleNameHint}"
                          LostFocus="CoreKeepRuleNameInput_LostFocus"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
              <CheckBox x:Name="CoreKeepRuleEnabledToggle" Content="{x:Static app:Strings.CoreKeepRuleEnabled}"
                        Checked="CoreKeepRuleEnabled_Changed" Unchecked="CoreKeepRuleEnabled_Changed"
                        Margin="0,0,0,8"/>
            </StackPanel>
          </Grid>

          <!-- 进程名 -->
          <StackPanel Margin="0,0,0,8">
            <TextBlock Text="{x:Static app:Strings.CoreKeepProcInputHint}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ui:TextBox x:Name="CoreKeepProcessPatternInput"
                        LostFocus="CoreKeepProcessPatternInput_LostFocus"/>
          </StackPanel>

          <!-- 模式 + 优先级 + 强制级别 三列 -->
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{x:Static app:Strings.CoreKeepModeLabel}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,4"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
              <ComboBox x:Name="CoreKeepModeCombo" MinWidth="120"
                        SelectionChanged="CoreKeepModeCombo_SelectionChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="{x:Static app:Strings.CoreKeepPriorityLabel}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,4"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
              <ComboBox x:Name="CoreKeepPriorityCombo" MinWidth="120"
                        SelectionChanged="CoreKeepPriorityCombo_SelectionChanged"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="{x:Static app:Strings.CoreKeepEnforcementLevelLabel}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,4"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
              <ComboBox x:Name="CoreKeepEnforcementCombo" MinWidth="120"
                        SelectionChanged="CoreKeepEnforcementCombo_SelectionChanged"/>
            </StackPanel>
          </Grid>

          <!-- 自定义掩码（仅 mode=custom 时可见） -->
          <StackPanel x:Name="CoreKeepCustomMaskPanel" Visibility="Collapsed" Margin="0,0,0,8">
            <TextBlock Text="{x:Static app:Strings.CoreKeepCustomMaskLabel}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ui:TextBox x:Name="CoreKeepCustomMaskInput"
                        PlaceholderText="{x:Static app:Strings.CoreKeepCustomMaskHint}"
                        LostFocus="CoreKeepCustomMaskInput_LostFocus"/>
          </StackPanel>

          <!-- 路径过滤 + 排除模式 双列 -->
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{x:Static app:Strings.CoreKeepPathFilterLabel}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,4"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
              <ui:TextBox x:Name="CoreKeepPathInput" MinWidth="160"
                          PlaceholderText="{x:Static app:Strings.CoreKeepPathFilterHint}"
                          LostFocus="CoreKeepPathInput_LostFocus"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="{x:Static app:Strings.CoreKeepExcludeLabel}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,4"
                         Foreground="{DynamicResource TextSecondaryBrush}"/>
              <ui:TextBox x:Name="CoreKeepExcludeInput" MinWidth="160"
                          PlaceholderText="{x:Static app:Strings.CoreKeepExcludeHint}"
                          LostFocus="CoreKeepExcludeInput_LostFocus"/>
            </StackPanel>
          </Grid>

          <!-- IFEO IO 优先级（持久化注册表，启动时读一次，非热路径） -->
          <StackPanel Margin="0,0,0,8">
            <TextBlock Text="{x:Static app:Strings.CoreKeepIoPriorityLabel}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ComboBox x:Name="CoreKeepIoPriorityCombo" MinWidth="160"
                      SelectionChanged="CoreKeepIoPriorityCombo_SelectionChanged">
              <ComboBoxItem Content="{x:Static app:Strings.CoreKeepIoPriorityNone}" Tag="-1"/>
              <ComboBoxItem Content="{x:Static app:Strings.CoreKeepIoPriorityVeryLow}" Tag="0"/>
              <ComboBoxItem Content="{x:Static app:Strings.CoreKeepIoPriorityLow}" Tag="1"/>
              <ComboBoxItem Content="{x:Static app:Strings.CoreKeepIoPriorityHigh}" Tag="3"/>
            </ComboBox>
          </StackPanel>

          <!-- 内存优先级（运行时 SetProcessInformation 生效） -->
          <StackPanel Margin="0,0,0,8">
            <TextBlock Text="{x:Static app:Strings.CoreKeepMemoryPriorityLabel}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ComboBox x:Name="CoreKeepMemoryPriorityCombo" MinWidth="160"
                      SelectionChanged="CoreKeepMemoryPriorityCombo_SelectionChanged">
              <ComboBoxItem Content="{x:Static app:Strings.CoreKeepMemoryPriorityNone}" Tag="-1"/>
              <ComboBoxItem Content="{x:Static app:Strings.CoreKeepMemoryPriorityVeryLow}" Tag="1"/>
              <ComboBoxItem Content="{x:Static app:Strings.CoreKeepMemoryPriorityLow}" Tag="2"/>
              <ComboBoxItem Content="{x:Static app:Strings.CoreKeepMemoryPriorityMedium}" Tag="3"/>
              <ComboBoxItem Content="{x:Static app:Strings.CoreKeepMemoryPriorityBelowNormal}" Tag="4"/>
              <ComboBoxItem Content="{x:Static app:Strings.CoreKeepMemoryPriorityNormal}" Tag="5"/>
            </ComboBox>
          </StackPanel>

          <!-- 锁定子进程 + 主线程绑定 + 立即应用 -->
          <Grid Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <CheckBox x:Name="CoreKeepLockToggle" Content="{x:Static app:Strings.CoreKeepLockBreakaway}"
                        Checked="CoreKeepLockToggle_Changed" Unchecked="CoreKeepLockToggle_Changed"
                        VerticalAlignment="Center" Margin="0,0,16,0"/>
              <CheckBox x:Name="CoreKeepMainThreadToggle" Content="{x:Static app:Strings.CoreKeepMainThreadLabel}"
                        Checked="CoreKeepMainThreadToggle_Changed" Unchecked="CoreKeepMainThreadToggle_Changed"
                        VerticalAlignment="Center" ToolTip="{x:Static app:Strings.CoreKeepMainThreadHint}"/>
            </StackPanel>
            <ui:Button x:Name="CoreKeepApplyNowBtn" Grid.Column="1"
                       Content="{x:Static app:Strings.CoreKeepApplyNow}"
                       Click="CoreKeepApplyNow_Click" Appearance="Primary"/>
          </Grid>

          <!-- 手动模式：核心选择 -->
          <StackPanel x:Name="CoreKeepCoreListPanel" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBlock Text="{x:Static app:Strings.CoreKeepCoreListLabel}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <ItemsControl x:Name="CoreKeepCoreList">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <CheckBox Content="{Binding CoreIndex}" IsChecked="{Binding IsChecked}"
                            Margin="0,0,12,4" Click="CoreKeepCoreCheckChanged"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ui:CardExpander>

      <!-- ══════ 5. 系统保留 CPU 核心集（ReservedCpuSets 注册表，重启生效） ══════ -->
      <ui:CardExpander Margin="0,0,0,8" Icon="Shield24" IsExpanded="False">
        <ui:CardExpander.Header>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Shield24" FontSize="{DynamicResource FontSizeHeader}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{x:Static app:Strings.CoreKeepReservedHeading}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentOmenBrush}" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Text="{x:Static app:Strings.CoreKeepReservedDesc}" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <ui:ToggleSwitch x:Name="ReservedMasterToggle" Grid.Column="1" VerticalAlignment="Center"
                            Checked="ReservedMasterToggle_Changed" Unchecked="ReservedMasterToggle_Changed"/>
          </Grid>
        </ui:CardExpander.Header>
        <StackPanel Margin="0,8,0,0">
          <TextBlock x:Name="ReservedUnsupportedHint" Text="{x:Static app:Strings.CoreKeepReservedUnsupported}"
                     FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,8" Foreground="#FFE74856" TextWrapping="Wrap" Visibility="Collapsed"/>
          <TextBlock Text="{x:Static app:Strings.CoreKeepReservedSelectCores}" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,0,4"
                     Foreground="{DynamicResource TextSecondaryBrush}"/>
          <ItemsControl x:Name="ReservedCoreList">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <CheckBox Content="{Binding CoreIndex}" IsChecked="{Binding IsChecked}"
                          Margin="0,0,12,4" Click="ReservedCoreCheck_Click"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="ReservedCurrentText" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
              <TextBlock x:Name="ReservedStatusText" FontSize="{DynamicResource FontSizeCaption}" Margin="0,2,0,0"
                         Foreground="{DynamicResource AccentOmenBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <ui:Button x:Name="ReservedRefreshBtn" Content="{x:Static app:Strings.CoreKeepRefreshBtn}"
                         Click="ReservedRefresh_Click" Appearance="Secondary" Margin="0,0,8,0"/>
              <ui:Button x:Name="ReservedApplyNowBtn" Content="{x:Static app:Strings.CoreKeepReservedApplyNow}"
                         Click="ReservedApplyNow_Click" Appearance="Primary"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </ui:CardExpander>

      <!-- ══════ 6. 守护定时器 + 核心竞速 ══════ -->
      <ui:CardControl Margin="0,0,0,8">
        <ui:CardControl.Header>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Timer24" FontSize="{DynamicResource FontSizeHeader}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{x:Static app:Strings.CoreKeepGuardLabel}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentOmenBrush}" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Text="{x:Static app:Strings.CoreKeepGuardIntervalLabel}" FontSize="{DynamicResource FontSizeCaption}"
                         Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>
            <ui:ToggleSwitch x:Name="CoreKeepGuardToggle" Grid.Column="1" VerticalAlignment="Center"
                            Checked="CoreKeepGuardToggle_Changed" Unchecked="CoreKeepGuardToggle_Changed"/>
          </Grid>
        </ui:CardControl.Header>
      </ui:CardControl>

      <ui:CardControl Margin="0,0,0,8">
        <ui:CardControl.Header>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{x:Static app:Strings.CoreKeepGuardIntervalLabel}" VerticalAlignment="Center"
                         FontSize="{DynamicResource FontSizeSubtitle}" Margin="0,0,8,0"/>
              <ui:NumberBox x:Name="CoreKeepGuardInterval" Minimum="1" Maximum="10" SmallChange="1"
                            MaxDecimalPlaces="0" Value="2" ValueChanged="CoreKeepGuardInterval_Changed"
                            MinWidth="100"/>
            </StackPanel>
            <ui:Button x:Name="CoreKeepBenchBtn" Grid.Column="1"
                       Content="{x:Static app:Strings.CoreKeepBenchBtn}"
                       Click="CoreKeepBenchmark_Click" Appearance="Secondary"/>
          </Grid>
        </ui:CardControl.Header>
      </ui:CardControl>

    </StackPanel>
  </ScrollViewer>
</Page>
