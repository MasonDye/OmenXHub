		                           Text="{x:Static app:Strings.DashboardHpDriverDesc}"/>
              </StackPanel>
            </ui:CardControl.Header>
          </ui:CardControl>

          <ui:CardControl>
            <ui:CardControl.Header>
              <StackPanel>
