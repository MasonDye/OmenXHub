<Page x:Class="OmenSuperHub.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:app="clr-namespace:OmenSuperHub"
      Title="{x:Static app:Strings.PageDashboard}"
      SizeChanged="DashboardPage_SizeChanged">

  <Page.Resources>
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Rectangle x:Name="PART_Track" RadiusX="4" RadiusY="4"
                         Fill="{DynamicResource ControlFillSecondaryBrush}"/>
              <Rectangle x:Name="PART_Indicator" RadiusX="4" RadiusY="4"
                         Fill="{TemplateBinding Foreground}"
                         HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,16" MinWidth="400" TextElement.Foreground="{DynamicResource TextPrimaryBrush}">

      <TextBlock Text="{x:Static app:Strings.DashboardHeading}" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

      <Grid x:Name="MetricsGrid" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- CPU -->
        <ui:CardControl Grid.Row="0" Grid.Column="0">
          <ui:CardControl.Header>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="{DynamicResource FontSizeSubheader}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <TextBlock Text="{x:Static app:Strings.MonitorCpuLabel}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSubtitle}" VerticalAlignment="Center"/>
                </StackPanel>
                <Path x:Name="CpuBrandLogo" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top"
                      Width="40" Height="40" Margin="0,4,4,0" Opacity="0.06" Stretch="Uniform"
                      IsHitTestVisible="False" Fill="Transparent" Visibility="Collapsed"/>
              </Grid>
              <StackPanel x:Name="CpuDetailPanel" Grid.Row="1" Margin="0,8,0,0">
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Static app:Strings.TempCelsius}" FontSize="{DynamicResource FontSizeCaption}"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             VerticalAlignment="Center"/>
                  <ProgressBar x:Name="CpuTempBar" Grid.Column="1" Height="8" VerticalAlignment="Center"
                               Margin="8,0,8,0" Minimum="0" Maximum="100"/>
                  <TextBlock Grid.Column="2" x:Name="CpuTempText" Text="-" FontSize="{DynamicResource FontSizeCaption}"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Static app:Strings.UtilizationLabel}" FontSize="{DynamicResource FontSizeCaption}"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             VerticalAlignment="Center"/>
                  <ProgressBar x:Name="CpuUtilBar" Grid.Column="1" Height="8" VerticalAlignment="Center"
                               Margin="8,0,8,0" Minimum="0" Maximum="100"/>
                  <TextBlock Grid.Column="2" x:Name="CpuUtilText" Text="-" FontSize="{DynamicResource FontSizeCaption}"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Static app:Strings.FanLabel}" FontSize="{DynamicResource FontSizeCaption}"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             VerticalAlignment="Center"/>
                  <ProgressBar x:Name="CpuFanBar" Grid.Column="1" Height="8" VerticalAlignment="Center"
                               Margin="8,0,8,0" Minimum="0" Maximum="6400"/>
                  <TextBlock Grid.Column="2" x:Name="CpuFanText" Text="-" FontSize="{DynamicResource FontSizeCaption}"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Static app:Strings.PowerLabel}" FontSize="{DynamicResource FontSizeCaption}"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             VerticalAlignment="Center"/>
                  <ProgressBar x:Name="CpuPowerBar" Grid.Column="1" Height="8" VerticalAlignment="Center"
                               Margin="8,0,8,0" Minimum="0" Maximum="150"/>
                  <TextBlock Grid.Column="2" x:Name="CpuPowerText" Text="-" FontSize="{DynamicResource FontSizeCaption}"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,6,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Static app:Strings.ClockLabel}" FontSize="{DynamicResource FontSizeCaption}"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             VerticalAlignment="Center"/>
                  <ProgressBar x:Name="CpuClockBar" Grid.Column="1" Height="8" VerticalAlignment="Center"
                               Margin="8,0,8,0" Minimum="0" Maximum="6000"/>
                  <TextBlock Grid.Column="2" x:Name="CpuClockText" Text="-" FontSize="{DynamicResource FontSizeCaption}"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
              </StackPanel>
              <TextBlock x:Name="CpuOffMessage" Grid.Row="1" Text="{x:Static app:Strings.CpuMonitorOff}"
                         FontSize="{DynamicResource FontSizeBody}" FontStyle="Italic"
                         Foreground="{DynamicResource TextFillColorDisabledBrush}"
                         VerticalAlignment="Center" HorizontalAlignment="Center"
                         Visibility="Collapsed"/>
            </Grid>
          </ui:CardControl.Header>
        </ui:CardControl>

        <!-- GPU -->
        <ui:CardControl Grid.Row="0" Grid.Column="2">
          <ui:CardControl.Header>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="DeviceEq24" FontSize="{DynamicResource FontSizeSubheader}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <TextBlock Text="{x:Static app:Strings.MonitorGpuLabel}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSubtitle}" VerticalAlignment="Center"/>
                </StackPanel>
                <Path x:Name="GpuBrandLogo" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top"
                      Width="40" Height="40" Margin="0,4,4,0" Opacity="0.06" Stretch="Uniform"
                      IsHitTestVisible="False" Fill="Transparent" Visibility="Collapsed"/>
              </Grid>
              <StackPanel x:Name="GpuDetailPanel" Grid.Row="1" Margin="0,8,0,0">
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Static app:Strings.TempCelsius}" FontSize="{DynamicResource FontSizeCaption}"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             VerticalAlignment="Center"/>
                  <ProgressBar x:Name="GpuTempBar" Grid.Column="1" Height="8" VerticalAlignment="Center"
                               Margin="8,0,8,0" Minimum="0" Maximum="100"/>
                  <TextBlock Grid.Column="2" x:Name="GpuTempText" Text="-" FontSize="{DynamicResource FontSizeCaption}"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Static app:Strings.UtilizationLabel}" FontSize="{DynamicResource FontSizeCaption}"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             VerticalAlignment="Center"/>
                  <ProgressBar x:Name="GpuUtilBar" Grid.Column="1" Height="8" VerticalAlignment="Center"
                               Margin="8,0,8,0" Minimum="0" Maximum="100"/>
                  <TextBlock Grid.Column="2" x:Name="GpuUtilText" Text="-" FontSize="{DynamicResource FontSizeCaption}"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Static app:Strings.FanLabel}" FontSize="{DynamicResource FontSizeCaption}"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             VerticalAlignment="Center"/>
                  <ProgressBar x:Name="GpuFanBar" Grid.Column="1" Height="8" VerticalAlignment="Center"
                               Margin="8,0,8,0" Minimum="0" Maximum="6400"/>
                  <TextBlock Grid.Column="2" x:Name="GpuFanText" Text="-" FontSize="{DynamicResource FontSizeCaption}"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Static app:Strings.PowerLabel}" FontSize="{DynamicResource FontSizeCaption}"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             VerticalAlignment="Center"/>
                  <ProgressBar x:Name="GpuPowerBar" Grid.Column="1" Height="8" VerticalAlignment="Center"
                               Margin="8,0,8,0" Minimum="0" Maximum="170"/>
                  <TextBlock Grid.Column="2" x:Name="GpuPowerText" Text="-" FontSize="{DynamicResource FontSizeCaption}"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,6,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="64"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Static app:Strings.ClockLabel}" FontSize="{DynamicResource FontSizeCaption}"
                             Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             VerticalAlignment="Center"/>
                  <ProgressBar x:Name="GpuClockBar" Grid.Column="1" Height="8" VerticalAlignment="Center"
                               Margin="8,0,8,0" Minimum="0" Maximum="3000"/>
                  <TextBlock Grid.Column="2" x:Name="GpuClockText" Text="-" FontSize="{DynamicResource FontSizeCaption}"
                             Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                             VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
              </StackPanel>
              <TextBlock x:Name="GpuOffMessage" Grid.Row="1" Text="{x:Static app:Strings.GpuMonitorOff}"
                         FontSize="{DynamicResource FontSizeBody}" FontStyle="Italic"
                         Foreground="{DynamicResource TextFillColorDisabledBrush}"
                         VerticalAlignment="Center" HorizontalAlignment="Center"
                         Visibility="Collapsed"/>
            </Grid>
          </ui:CardControl.Header>
        </ui:CardControl>

        <!-- Memory -->
        <!-- ponytail: CardControl 默认 VerticalAlignment=Center(WPF-UI 样式),同行两卡内容不等高时
             矮卡不被拉伸导致边框不齐 — 显式 Stretch 让运存/储存卡片等高(行高取两者内容上限)。 -->
        <ui:CardControl Grid.Row="1" Grid.Column="0" Margin="0,12,0,0" MinHeight="180" VerticalAlignment="Stretch">
          <ui:CardControl.Header>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Ram20" FontSize="{DynamicResource FontSizeSubheader}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <TextBlock Text="{x:Static app:Strings.DashboardMemoryLabel}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSubtitle}" VerticalAlignment="Center"/>
                </StackPanel>
              </Grid>
              <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- ponytail: 运存圆环 — 复用 DrawRing 的 ArcSegment 几何,
                     中心显示利用率百分比。与系统状态圆环同款几何,side=112。 -->
                <Grid Width="112" Height="112" VerticalAlignment="Center" HorizontalAlignment="Left">
                  <Path x:Name="MemRingTrack" Stroke="{DynamicResource ControlFillSecondaryBrush}" StrokeThickness="9"/>
                  <Path x:Name="MemRingArc" Stroke="{DynamicResource AccentOmenBrush}" StrokeThickness="9"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="MemRingPctText" Text="-" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Static app:Strings.UtilizationLabel}" FontSize="10"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="48"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static app:Strings.DashboardMemoryUsedLabel}" FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="RamDetailText" Text="-" FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  </Grid>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="48"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static app:Strings.DashboardMemoryVirtualLabel}" FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="RamVirtualText" Text="-" FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  </Grid>
                  <Button x:Name="CleanMemBtn" MinHeight="26" Padding="10,2" FontSize="{DynamicResource FontSizeCaption}"
                          HorizontalAlignment="Left" Margin="0,4,0,0" Click="CleanMemory_Click">
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon Symbol="Broom24" FontSize="{DynamicResource FontSizeSubtitle}" Margin="0,0,4,0"/>
                      <TextBlock Text="{x:Static app:Strings.DashboardMemoryCleanBtn}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Grid>
          </ui:CardControl.Header>
        </ui:CardControl>

        <!-- Storage -->
        <ui:CardControl Grid.Row="1" Grid.Column="2" Margin="0,12,0,0" MinHeight="180" VerticalAlignment="Stretch">
          <ui:CardControl.Header>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Storage24" FontSize="{DynamicResource FontSizeSubheader}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <TextBlock Text="{x:Static app:Strings.DashboardStorageLabel}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSubtitle}" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- ponytail: 储存清理入口 — 参考 Dism++ 空间回收,弹窗勾选系统垃圾类目 -->
                <ui:Button Grid.Column="2" Content="{x:Static app:Strings.StorageCleanTitle}"
                           Height="28" Padding="10,0" HorizontalAlignment="Right"
                           Click="StorageClean_Click">
                  <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Broom24" FontSize="{DynamicResource FontSizeSubtitle}"/>
                  </ui:Button.Icon>
                </ui:Button>
              </Grid>
              <!-- ponytail: 储存柱状图 — 每盘一根竖条,高度=已用占比,颜色按占比渐变。
                   Canvas 固定 220×132 容纳至多 8 盘(每柱 24px + 4px 间隔);
                   超过 8 盘降级到文字列表 RefreshStorageLegacy()。上限:单盘>99% 颜色顶 AccentRed。 -->
              <Canvas x:Name="StorageBarCanvas" Grid.Row="1" Width="220" Height="132"
                      Margin="0,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </Grid>
          </ui:CardControl.Header>
        </ui:CardControl>
      </Grid>

      <!-- ══════ 系统状态 / 性能预设 (双列) ══════ -->
      <Grid x:Name="StatusGrid" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:CardControl Grid.Row="0" Grid.Column="0">
          <ui:CardControl.Header>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ui:SymbolIcon Symbol="Info24" FontSize="{DynamicResource FontSizeSubheader}" VerticalAlignment="Top" Margin="0,2,0,0"/>
              <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="{x:Static app:Strings.SysStatusHeading}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSubtitle}" Margin="0,0,0,10"/>
                <Grid Margin="{StaticResource CardMargin}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Static app:Strings.PerfModeLabel}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             VerticalAlignment="Center"/>
                  <TextBlock x:Name="CurrentModeText" Grid.Column="1" Foreground="{DynamicResource AccentOmenBrush}"
                             FontWeight="SemiBold" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="{StaticResource CardMargin}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Static app:Strings.FanControl}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             VerticalAlignment="Center"/>
                  <TextBlock x:Name="CurrentFanText" Grid.Column="1" Foreground="{DynamicResource AccentOmenBrush}"
                             FontWeight="SemiBold" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center"/>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Static app:Strings.PowerStatus}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             VerticalAlignment="Center"/>
                  <TextBlock x:Name="PowerStatusText" Grid.Column="1" Foreground="{DynamicResource AccentGreenBrush}"
                             FontWeight="SemiBold" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>
              <Grid Grid.Column="2" Width="112" Height="112" Margin="14,0,0,0" VerticalAlignment="Center">
                <Path x:Name="RingTrack" Stroke="{DynamicResource ControlFillSecondaryBrush}" StrokeThickness="9"/>
                <Path x:Name="RingArc" Stroke="{DynamicResource AccentOmenBrush}" StrokeThickness="9"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock x:Name="RingLabelText" Text="{x:Static app:Strings.DashboardTendencyLabel}"
                             FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                             HorizontalAlignment="Center"/>
                  <TextBlock x:Name="RingPctText" Text="-" FontSize="20" FontWeight="Bold"
                             Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
              </Grid>
            </Grid>
          </ui:CardControl.Header>
        </ui:CardControl>

        <ui:CardControl Grid.Row="0" Grid.Column="2">
          <ui:CardControl.Header>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ui:SymbolIcon Symbol="PresenceAvailable24" FontSize="{DynamicResource FontSizeSubheader}" VerticalAlignment="Top" Margin="0,2,0,0"/>
              <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="{x:Static app:Strings.SysPresetsHeading}" FontWeight="SemiBold"
                           FontSize="{DynamicResource FontSizeSubtitle}" Margin="0,0,0,10"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ComboBox x:Name="PresetCombo" MinWidth="120"
                            SelectionChanged="Preset_SelectionChanged"/>
                  <Button x:Name="PresetRenameBtn" Grid.Column="1" Width="28" Height="28"
                          Padding="0" Margin="4,0" Click="PresetRename_Click"
                          ToolTip="{x:Static app:Strings.RenamePreset}" Visibility="Collapsed">
                    <ui:SymbolIcon Symbol="Edit24" FontSize="{DynamicResource FontSizeSubtitle}"/>
                  </Button>
                  <Button x:Name="PresetSaveBtn" Grid.Column="2" Width="28" Height="28"
                          Padding="0" Margin="4,0" Click="PresetSave_Click"
                          ToolTip="{x:Static app:Strings.SaveTooltip}" Visibility="Collapsed">
                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="{DynamicResource FontSizeSubtitle}"/>
                  </Button>
                </Grid>
              </StackPanel>
              <Canvas x:Name="RadarCanvas" Grid.Column="2" Width="112" Height="112"
                      Margin="14,0,0,0" VerticalAlignment="Center"/>
            </Grid>
          </ui:CardControl.Header>
        </ui:CardControl>

      </Grid>

      <!-- ══════ 系统信息 / Device Info (migrated from SysInfoPage) ══════ -->

      <Grid x:Name="SysInfoGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0">
          <ui:CardControl Margin="0,0,0,8">
          <ui:CardControl.Header>
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <ui:SymbolIcon Symbol="Info24" FontSize="{DynamicResource FontSizeHeader}" Margin="0,0,8,0"/>
                <TextBlock Text="{x:Static app:Strings.SysInfoHeading}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{DynamicResource AccentOmenBrush}" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock x:Name="SysManufacturerText" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
              <TextBlock x:Name="SysModelText" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
              <TextBlock x:Name="SysValidationText" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
              <TextBlock x:Name="SysBoardText" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
              <TextBlock x:Name="SysBiosText" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
              <TextBlock x:Name="SysCpuText" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
