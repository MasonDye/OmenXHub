                    <ui:SymbolIcon Symbol="Info24" FontSize="{DynamicResource FontSizeHeader}" Margin="0,0,8,0"/>
                    <TextBlock Text="{x:Static app:Strings.SensorTempsHeading}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{DynamicResource AccentOmenBrush}"/>
                  </StackPanel>
                  <Button x:Name="SysInfoRefreshBtn" Grid.Column="1"
