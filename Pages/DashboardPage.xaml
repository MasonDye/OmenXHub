                    <TextBlock Text="{x:Static app:Strings.MonitorGpuLabel}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="MonGpuCombo" Grid.Column="1" MinWidth="100"
                              SelectionChanged="MonGpu_SelectionChanged">
                      <ComboBoxItem Content="{x:Static app:Strings.MonitorGpuOn}"/>
                      <ComboBoxItem Content="{x:Static app:Strings.MonitorGpuOff}"/>
                    </ComboBox>
                  </Grid>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
