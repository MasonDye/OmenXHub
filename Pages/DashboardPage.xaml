                <TextBlock x:Name="SysCpuTjmaxDistanceText" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="SysNvmeText" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="SysMotherboardText" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" Visibility="Collapsed"/>
              </StackPanel>
            </ui:CardControl.Header>
          </ui:CardControl>

          <ui:CardControl Margin="0,8,0,0">
