<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>OmenSuperHub</RootNamespace>
    <AssemblyName>OmenXHub</AssemblyName>
    <ApplicationIcon>Resources\fan.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <LangVersion>latest</LangVersion>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationVersion>4.0.%2a</ApplicationVersion>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>TRACE;DEBUG</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- NuGet Packages -->
  <ItemGroup>
    <PackageReference Include="Fody" Version="6.5.5" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="all" />
    <PackageReference Include="HidSharp" Version="2.1.0" />
    <PackageReference Include="Microsoft.Windows.WDK.x64" Version="10.0.28000.1839" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NvAPIWrapper.Net" Version="0.8.1.101" />
    <!-- ponytail: removed unused Microsoft.Extensions.ObjectPool 6.0.4 -->

    <PackageReference Include="System.Resources.Extensions" Version="8.0.0" />
    <!-- ponytail: force System.Runtime.CompilerServices.Unsafe 6.0.0 to resolve MSB3277 version conflict
         (HP.Omen.CoreUtilities references 4.0.4.1, System.Resources.Extensions references 6.0.0.0) -->
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
    <PackageReference Include="WPF-UI" Version="3.*" />
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.22621.2" />
  </ItemGroup>

  <!-- Local DLL References -->
  <ItemGroup>
    <Reference Include="HP.Omen.Core.Common">
      <HintPath>Resources\HP.Omen.Core.Common.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="HP.Omen.Core.Model.Device">
      <HintPath>Resources\HP.Omen.Core.Model.Device.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="McuSDK2">
      <HintPath>Resources\McuSDK2.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- ponytail: SMBiosSDK/Utf8Json restored — runtime deps of HP.Omen.Core.Model.Device.dll
         (SMBIOS table read + JSON deserialization), loaded via Costura AssemblyResolve.
         Static "zero C# refs" analysis was wrong: DeviceModel.ThisSystemID/GetPlatformSku
         throw without them → board product shows 未知, CPU temp wall falls back to 100. -->
    <EmbeddedResource Include="Resources\SMBiosSDK.dll" />
    <EmbeddedResource Include="Resources\Utf8Json.dll" />
    <!-- PerformanceControl: HP firmware control helper, required for DeviceModel.IsHP etc. -->
    <Reference Include="PerformanceControl">
      <HintPath>Resources\PerformanceControl.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OmenFourZoneLighting">
      <HintPath>Resources\OmenFourZoneLighting.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.Win32.TaskScheduler">
      <HintPath>lib\Microsoft.Win32.TaskScheduler.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- Intel XTU 超频: 复用 OGH (OmenCommandCenter) 的官方托管 SDK。
         传输层是 HP 自有 MSRPC/ncalrpc (端点 HPOmenRpcEndpoint,NativeRpcClient.dll 原生实现) —
         自造管道协议不可行(XtuService.exe 不开命名管道)。NativeRpcClient 为原生 DLL,
         启动时经 ExtractAndPreloadNativeDll 释放到 exe 目录。 -->
    <Reference Include="IntelXTUSDK">
      <HintPath>Resources\IntelXTUSDK.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="RpcClient">
      <HintPath>Resources\RpcClient.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Logging">
      <HintPath>Resources\Logging.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <EmbeddedResource Include="Resources\NativeRpcClient.dll" />
  </ItemGroup>

  <!-- Framework References -->
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Management" />
    <Reference Include="System.Numerics" />
    <Reference Include="Microsoft.VisualBasic" />
    <!-- ponytail: System.Windows.Forms.DataVisualization / WindowsFormsIntegration 0 引用已删除 -->
  </ItemGroup>

  <!-- Project Reference -->
  <ItemGroup>
    <ProjectReference Include="LibreHardwareMonitor-pawnio-squashed\LibreHardwareMonitorLib\LibreHMLib_PawnIo.csproj" />
  </ItemGroup>

  <!-- Exclude packages.config (SDK-style uses PackageReference) -->
  <ItemGroup>
    <Compile Remove="packages\**" />
    <Compile Remove="backup\**" />
    <Compile Remove="LibreHardwareMonitor-pawnio-squashed\**" />
    <EmbeddedResource Remove="packages\**" />
    <None Remove="packages\**" />
  </ItemGroup>

  <!-- Embedded Resources -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\fan.ico" />
    <EmbeddedResource Remove="Properties\Resources.resx" />

    <EmbeddedResource Include="Resources\nvpcf_cat.CAT" />
    <EmbeddedResource Include="Resources\nvpcf_sys.sys" />
    <EmbeddedResource Include="Resources\nvpcf_inf.inf" />
    <EmbeddedResource Include="Resources\NvidiaApi.dll" />
    <EmbeddedResource Include="Resources\McuSDK2.dll" />
    <EmbeddedResource Include="Resources\HP.Omen.Core.Common.dll" />
    <EmbeddedResource Include="Resources\HP.Omen.Core.Model.Device.dll" />
    <!-- ponytail: HP.Omen.Core.Api/Model.DataStructure/Utilities/Logger/Logger.APIs/Logger
         restored — runtime deps of HP.Omen.Core.Model.Device.dll + PerformanceControl.dll,
         loaded via Costura AssemblyResolve. -->
    <EmbeddedResource Include="Resources\HP.Omen.Core.Api.dll" />
    <EmbeddedResource Include="Resources\HP.Omen.Core.Model.DataStructure.dll" />
    <EmbeddedResource Include="Resources\HP.Omen.Core.Utilities.dll" />
    <EmbeddedResource Include="Resources\HP.Omen.Core.Logger.dll" />
    <EmbeddedResource Include="Resources\HP.Omen.Logger.dll" />
    <EmbeddedResource Include="Resources\HP.Omen.Logger.APIs.dll" />
    <EmbeddedResource Include="Resources\System.Threading.Tasks.Extensions.dll" />
    <EmbeddedResource Include="Resources\PerformanceControl.dll" />
    <EmbeddedResource Include="Resources\OmenFourZoneLighting.dll" />
    <EmbeddedResource Include="Resources\OmenLightingSDK.dll" />
    <EmbeddedResource Include="Resources\SingBox\sing-box.exe.gz" />
    <EmbeddedResource Include="Resources\SingBox\wintun.dll.gz" />
  </ItemGroup>

  <!-- Resource (Fluent Icons) -->
  <ItemGroup>
    <Resource Include="Resources\Fonts\FluentSystemIcons-Regular.ttf" />
  </ItemGroup>

  <!-- Exclude auto-include of obj/bin/packages directories -->
  <ItemGroup>
    <EmbeddedResource Remove="bin\**" />
    <EmbeddedResource Remove="obj\**" />
    <None Remove="bin\**" />
    <None Remove="obj\**" />
    <Compile Remove="packages\**" />
    <EmbeddedResource Remove="packages\**" />
    <None Remove="packages\**" />
  </ItemGroup>

  <!-- Exclude old packages/ folder from reference resolution -->
  <PropertyGroup>
    <ResolveAssemblyReferencesSilentlyPreferTargetFrameworkDirectory>true</ResolveAssemblyReferencesSilentlyPreferTargetFrameworkDirectory>
    <!-- ponytail: WDK 10.0.28000.1839 wants SDK.CPP.x64 exactly 10.0.28000 but only 10.0.28000.1721 is available;
         patch-level difference is harmless for build. Suppress the fall-back warning.
         Also suppress MSB3245/MSB3246 — Mono.Posix only loaded via reflection on Linux path;
         never executed on Windows-only OmenSuperHub build. -->
    <NoWarn>$(NoWarn);NU1603;MSB3245;MSB3246</NoWarn>
  </PropertyGroup>

</Project>
