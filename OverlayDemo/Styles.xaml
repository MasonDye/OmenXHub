<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      视觉规格：
      - 卡片 168×60 / 通栏 336×60 / 网络 334×60，垂直渐变 #323232→#282828
      - 文字 16/26/18/12 全带黑投影 (BlurRadius=4, ShadowDepth=1, Opacity=0.5)
      - 温度色 白/绿#0FFA84/橙#FFA338/红#F9350F
      - rail 开关 48×48 圆角4；热键按钮 48 宽圆角6；滑条 8 高轨道 + 16 圆 thumb；
        色板 18/16 双层圆；性能模式按钮 140×24 圆角4 图标+文字；风扇行 185×24 圆角6
    -->

    <FontFamily x:Key="OverlayFont">Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

    <SolidColorBrush x:Key="TextBrush" Color="#FFEEEEEE" />
    <SolidColorBrush x:Key="PureWhite" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="WidgetBorderBrush" Color="#FF212121" />
    <SolidColorBrush x:Key="ControlButtonBackground" Color="#FF333333" />
    <SolidColorBrush x:Key="ControlButtonBackgroundHover" Color="#FF454545" />
    <SolidColorBrush x:Key="ControlButtonBorder" Color="#FF4A4A4A" />
    <SolidColorBrush x:Key="ControlButtonBorderHover" Color="#FF666666" />
    <SolidColorBrush x:Key="ControlMenuBackground" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="ControlMenuBorder" Color="#FF4A4A4A" />
    <SolidColorBrush x:Key="DividerBrush" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="TooltipBackground" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="TooltipBorder" Color="#FF555555" />
    <SolidColorBrush x:Key="Gray30" Color="#FF4D4D4D" />
    <SolidColorBrush x:Key="SelectedButtonBackground" Color="#FF3F3F3F" />
    <SolidColorBrush x:Key="SelectedButtonBorder" Color="#FFEEEEEE" />
    <SolidColorBrush x:Key="RailButtonBackground" Color="#FF333333" />
    <SolidColorBrush x:Key="RailButtonBackgroundSelected" Color="#FF454545" />
    <SolidColorBrush x:Key="RailButtonBorder" Color="#FF4A4A4A" />
    <SolidColorBrush x:Key="SliderTrackBackground" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="SliderThumbFill" Color="#FFDDDDDD" />

    <LinearGradientBrush x:Key="CardGradient" StartPoint="1,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF323232" />
        <GradientStop Offset="1" Color="#FF282828" />
    </LinearGradientBrush>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <Style x:Key="ShadowText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OverlayFont}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="4" Direction="270" Opacity="0.5" ShadowDepth="1" Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 指标卡（168×60 / 通栏 336 / 网络 334） ============ -->

    <Style x:Key="CardBasic" TargetType="ContentControl">
        <Setter Property="Width" Value="168" />
        <Setter Property="Height" Value="60" />
        <Setter Property="Visibility" Value="{Binding MenuChecked, Converter={StaticResource BoolToVis}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Margin="0,1,2,1">
                        <Border Opacity="{Binding MenuBgTransparency}" Background="{StaticResource CardGradient}" />
                        <TextBlock Style="{StaticResource ShadowText}" Text="{Binding MenuName}" Margin="16,5,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="16"
                                   Foreground="{Binding MenuColor}" Opacity="{Binding MenuTextTransparency}" />
                        <Grid Height="30" Margin="16,25,0,0">
                            <TextBlock Style="{StaticResource ShadowText}" Text="{Binding MenuData}"
                                       HorizontalAlignment="Left" VerticalAlignment="Bottom" FontSize="26"
                                       Foreground="{Binding MenuColor}" Opacity="{Binding MenuTextTransparency}" />
                            <TextBlock Style="{StaticResource ShadowText}" Text="{Binding MenuData2}" Margin="92,0,0,2"
                                       HorizontalAlignment="Left" VerticalAlignment="Bottom" FontSize="18"
                                       Foreground="{Binding MenuColorEx}" Opacity="{Binding MenuTextTransparency}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CardExtended" TargetType="ContentControl" BasedOn="{StaticResource CardBasic}">
        <Setter Property="Width" Value="336" />
    </Style>

    <Style x:Key="CardNetwork" TargetType="ContentControl">
        <Setter Property="Width" Value="334" />
        <Setter Property="Height" Value="60" />
        <Setter Property="Visibility" Value="{Binding MenuChecked, Converter={StaticResource BoolToVis}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid Margin="0,1,2,1">
                        <Border Opacity="{Binding MenuBgTransparency}" Background="{StaticResource CardGradient}" />
                        <TextBlock Style="{StaticResource ShadowText}" Text="{Binding MenuName}" Margin="16,5,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="16"
                                   Foreground="{Binding MenuColor}" Opacity="{Binding MenuTextTransparency}" />
                        <Grid Height="30" Margin="16,25,0,0">
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="14" Text="&#xE898;"
                                           VerticalAlignment="Center" Foreground="{Binding MenuColor}"
                                           Opacity="{Binding MenuTextTransparency}" />
                                <TextBlock Style="{StaticResource ShadowText}" Text="{Binding MenuData}" Margin="4,0,0,0"
                                           VerticalAlignment="Bottom" FontSize="26"
                                           Foreground="{Binding MenuColor}" Opacity="{Binding MenuTextTransparency}" />
                                <TextBlock Style="{StaticResource ShadowText}" Text="Mbps" Margin="6,0,0,4"
                                           VerticalAlignment="Bottom" FontSize="12"
                                           Foreground="{Binding MenuColor}" Opacity="{Binding MenuTextTransparency}" />
                            </StackPanel>
                            <StackPanel Margin="168,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="14" Text="&#xE896;"
                                           VerticalAlignment="Center" Foreground="{Binding MenuColor}"
                                           Opacity="{Binding MenuTextTransparency}" />
                                <TextBlock Style="{StaticResource ShadowText}" Text="{Binding MenuData2}" Margin="4,0,0,0"
                                           VerticalAlignment="Bottom" FontSize="26"
                                           Foreground="{Binding MenuColor}" Opacity="{Binding MenuTextTransparency}" />
                                <TextBlock Style="{StaticResource ShadowText}" Text="Mbps" Margin="6,0,0,4"
                                           VerticalAlignment="Bottom" FontSize="12"
                                           Foreground="{Binding MenuColor}" Opacity="{Binding MenuTextTransparency}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="CardTemplate">
        <ContentControl Style="{Binding MenuStyle}" />
    </DataTemplate>

    <!-- ============ 控制条（锁 18px 图标 / 菜单 16px，24×24 底座） ============ -->

    <Style x:Key="OverlayIconButton" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Width="24" Height="24" Background="{StaticResource ControlButtonBackground}"
                            BorderBrush="{StaticResource ControlButtonBorder}" BorderThickness="1" CornerRadius="2">
                        <TextBlock x:Name="icon" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ControlButtonBackgroundHover}" />
                            <Setter TargetName="icon" Property="Foreground" Value="{StaticResource PureWhite}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LockToggle" TargetType="CheckBox">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="border" Width="24" Height="24" Background="{StaticResource ControlButtonBackground}"
                            BorderBrush="{StaticResource ControlButtonBorder}" BorderThickness="1" CornerRadius="2">
                        <TextBlock x:Name="icon" FontFamily="{StaticResource IconFont}" FontSize="16" Text="&#xE72E;"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource PureWhite}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="icon" Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter TargetName="icon" Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ControlButtonBackgroundHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 菜单按钮行：20×20 无边框字形，悬停变白 -->
    <Style x:Key="MenuGlyphButton" TargetType="Button">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Width="20" Height="20" Background="Transparent">
                        <TextBlock x:Name="icon" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="icon" Property="Foreground" Value="{StaticResource PureWhite}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OverlayToolTip" TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="{StaticResource OverlayFont}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource TooltipBackground}" BorderBrush="{StaticResource TooltipBorder}"
                            BorderThickness="1" CornerRadius="2" Padding="8,4">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 菜单内设置行：24 高 字12 左文右勾 -->
    <Style x:Key="MenuCheckRow" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="{StaticResource OverlayFont}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Height="24" Margin="10,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{TemplateBinding Content}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{StaticResource TextBrush}" />
                        <TextBlock x:Name="check" Grid.Column="1" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Text="&#xE73E;" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}" Opacity="0.3" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="check" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ rail：48×48 widget 开关（圆角4 边框1 中心图标） ============ -->

    <Style x:Key="RailWidgetToggle" TargetType="CheckBox">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="border" Width="48" Height="48"
                            Background="{StaticResource RailButtonBackground}"
                            BorderBrush="{StaticResource RailButtonBorder}" BorderThickness="1" CornerRadius="4">
                        <TextBlock x:Name="icon" FontFamily="{StaticResource IconFont}" FontSize="24"
                                   Text="{TemplateBinding Tag}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource RailButtonBackgroundSelected}" />
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource SelectedButtonBorder}" />
                            <Setter TargetName="icon" Property="Foreground" Value="{StaticResource PureWhite}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ControlButtonBorderHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- rail 图标按钮：20×20 无边框 -->
    <Style x:Key="RailGlyphButton" TargetType="Button">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Width="20" Height="20" Background="Transparent">
                        <TextBlock x:Name="icon" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="icon" Property="Foreground" Value="{StaticResource PureWhite}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 热键按钮：48 宽 圆角6 边框1，10 号热键文本，悬停换底 -->
    <Style x:Key="HotkeyRailButton" TargetType="Button">
        <Setter Property="Width" Value="48" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Width="48" Height="36"
                            Background="{StaticResource RailButtonBackground}"
                            BorderBrush="{StaticResource RailButtonBorder}" BorderThickness="1" CornerRadius="6">
                        <TextBlock x:Name="text" Text="{TemplateBinding Content}" FontSize="10" TextAlignment="Center"
                                   FontFamily="{StaticResource OverlayFont}" Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ControlButtonBackgroundHover}" />
                            <Setter TargetName="text" Property="Foreground" Value="{StaticResource PureWhite}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 色板：18 外圈 + 16 内圆，选中外圈变白 ============ -->

    <Style x:Key="ColorSwatch" TargetType="RadioButton">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Width="18" Height="18">
                        <Ellipse x:Name="outer" Width="18" Height="18" Fill="{StaticResource Gray30}"
                                 Stroke="{StaticResource Gray30}" StrokeThickness="1" />
                        <Ellipse Width="16" Height="16" Fill="{TemplateBinding Background}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="outer" Property="Stroke" Value="{StaticResource PureWhite}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 滑条：8 高圆角5 轨道（边框1）+ 16 圆 thumb ============ -->

    <Style x:Key="TransparencySlider" TargetType="Slider">
        <Setter Property="Height" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border x:Name="TrackBackground" Height="8" Margin="5,0" VerticalAlignment="Center"
                                Background="{StaticResource SliderTrackBackground}"
                                BorderBrush="{StaticResource ControlButtonBorder}" BorderThickness="1" CornerRadius="5" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6" Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6" Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="16" Height="16" Fill="{StaticResource SliderThumbFill}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 性能模式按钮：140×24 圆角4 图标20+文字12 ============ -->

    <Style x:Key="ModeButton" TargetType="RadioButton">
        <Setter Property="Width" Value="140" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" Width="140" Height="24" BorderThickness="1" CornerRadius="4"
                            Background="{StaticResource ControlButtonBackground}"
                            BorderBrush="{StaticResource ControlButtonBorder}">
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock x:Name="icon" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="6,0,0,0"
                                       Text="{TemplateBinding Tag}" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock x:Name="text" Text="{TemplateBinding Content}" Margin="4,0,0,0" FontSize="12"
                                       MaxWidth="105" TextWrapping="Wrap" FontFamily="{StaticResource OverlayFont}"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectedButtonBackground}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource SelectedButtonBorder}" />
                            <Setter TargetName="text" Property="Foreground" Value="{StaticResource PureWhite}" />
                            <Setter TargetName="text" Property="FontWeight" Value="Bold" />
                            <Setter TargetName="icon" Property="Foreground" Value="{StaticResource PureWhite}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource ControlButtonBorderHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
