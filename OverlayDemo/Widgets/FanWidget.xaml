<UserControl x:Class="OverlayDemo.Widgets.FanWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 风扇卡：左风扇行列表 + 右温度面板，外框 2px 圆角8 -->
    <Border BorderThickness="2" CornerRadius="8"
            Background="{Binding WidgetBackground}" BorderBrush="{Binding WidgetBorderBrush}">
        <StackPanel Orientation="Horizontal">
            <ItemsControl Margin="4,4,0,4" VerticalAlignment="Center" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="185" Height="24" Margin="0,1" CornerRadius="6" BorderThickness="1"
                                Background="{StaticResource ControlButtonBackground}"
                                BorderBrush="{StaticResource ControlButtonBorder}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Width="16" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           Text="&#xE9D9;" Margin="4,0,0,0" Foreground="{Binding Color}"
                                           Opacity="{Binding TextOpacity}" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" MaxWidth="95" FontSize="12"
                                           FontFamily="{StaticResource OverlayFont}" Foreground="{Binding Color}"
                                           Opacity="{Binding TextOpacity}" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" Text="RPM" Margin="0,0,4,0" FontSize="10"
                                           FontFamily="{StaticResource OverlayFont}" Foreground="{Binding Color}"
                                           Opacity="{Binding TextOpacity}" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" Margin="0,0,3,0" FontSize="12"
                                           FontWeight="Bold" TextAlignment="Right" FontFamily="{StaticResource OverlayFont}"
                                           Foreground="{Binding Color}" Opacity="{Binding TextOpacity}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Width="115" Height="40" Margin="2,4,4,4" CornerRadius="6" BorderThickness="1"
                    Background="{StaticResource ControlButtonBackground}"
                    BorderBrush="{StaticResource ControlButtonBorder}">
                <ItemsControl VerticalAlignment="Center" Margin="6,0" ItemsSource="{Binding Temps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Height="17">
                                <TextBlock Text="{Binding Label}" FontSize="11" FontFamily="{StaticResource OverlayFont}"
                                           Foreground="{StaticResource TextBrush}" Opacity="{Binding TextOpacity}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Value}" FontSize="11" FontWeight="Bold"
                                           FontFamily="{StaticResource OverlayFont}" Foreground="{Binding Color}"
                                           Opacity="{Binding TextOpacity}" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
