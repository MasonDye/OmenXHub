<UserControl x:Class="OverlayDemo.Widgets.CompactWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="150">
    <!-- 紧凑条：与指标卡同款卡片，纵向堆叠 -->
    <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Width="168" Height="60" CornerRadius="8" BorderThickness="1" BorderBrush="#FF212121"
                        Background="{Binding Background}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <TextBlock Style="{StaticResource ShadowText}" Text="{Binding Label}" Width="46"
                                   FontSize="16" Foreground="{Binding LabelBrush}"
                                   Opacity="{Binding TextOpacity}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource ShadowText}" Text="{Binding Value}"
                                   FontSize="20" Foreground="{Binding Color}"
                                   Opacity="{Binding TextOpacity}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
