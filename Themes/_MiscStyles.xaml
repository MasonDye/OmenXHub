<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <DropShadowEffect x:Key="MenuShadow" BlurRadius="20" ShadowDepth="4"
                     Direction="270" Color="#80000000" Opacity="0.6"/>

  <!-- ponytail: 卡片样式 — 分层靠主题感知描边:暗色全透明(底色对比分层),
    亮色 6% 黑发丝线衬托浮起(小控件同款"底层阴影感")。圆角 4 与小控件同档。
    禁用 DropShadowEffect:栅格化会让卡内文字发灰、且自绘 Border 卡片不受益。 -->
  <Style BasedOn="{StaticResource {x:Type ui:CardControl}}" TargetType="{x:Type ui:CardControl}">
    <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
  </Style>

  <!-- ponytail: 性能卡值行 (NumberBox+Slider) 共用样式, BasedOn 默认保外观, 只统一布局属性。
       各自差异 (min/max/step/事件/绑定) 留在使用处。 -->
  <Style x:Key="PerfNumberBoxStyle" BasedOn="{StaticResource {x:Type ui:NumberBox}}" TargetType="ui:NumberBox">
    <Setter Property="MaxDecimalPlaces" Value="0"/>
  </Style>
  <Style x:Key="PerfValueSliderStyle" BasedOn="{StaticResource {x:Type Slider}}" TargetType="Slider">
    <Setter Property="Margin" Value="{StaticResource ValueSliderMargin}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="OmenContextMenu" TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="2,6"/>
    <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="HasDropShadow" Value="True"/>
  </Style>

  <Style x:Key="OmenMenuItem" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="FontFamily" Value="{DynamicResource DefaultFontFamily}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="12,7"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="2,1"
                  Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut"/>
                <ColumnDefinition Width="16"/>
              </Grid.ColumnDefinitions>
              <Grid Grid.Column="0" Margin="2,0,6,0" Width="18" VerticalAlignment="Center">
                <Ellipse x:Name="CheckMark" Width="8" Height="8" Fill="{DynamicResource AccentOmenBrush}"
                         VerticalAlignment="Center" HorizontalAlignment="Center"
                         Visibility="Collapsed"/>
                <ContentPresenter x:Name="Icon" ContentSource="Icon"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Width="16" Height="16"/>
              </Grid>
              <ContentPresenter Grid.Column="1" ContentSource="Header"
                                RecognizesAccessKey="True" VerticalAlignment="Center"/>
              <Path x:Name="SubMenuArrow" Grid.Column="3" VerticalAlignment="Center"
                    Data="M 0 0 L 5 4 L 0 8 Z" Fill="{DynamicResource TextSecondaryBrush}"
                    HorizontalAlignment="Right" Visibility="Collapsed"/>
              <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                     Placement="Right" AllowsTransparency="True" Focusable="False"
                     PopupAnimation="Fade" HorizontalOffset="0" VerticalOffset="-8">
                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                         CornerRadius="8" Padding="2,6" Effect="{DynamicResource MenuShadow}">
                  <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                </Border>
              </Popup>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="HasItems" Value="True">
              <Setter TargetName="SubMenuArrow" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource TextAccentBrush}"/>
              <Setter TargetName="SubMenuArrow" Property="Fill" Value="{DynamicResource AccentOmenBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="OmenMenuSeparator" TargetType="Separator">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Margin" Value="12,4"/>
    <Setter Property="Background" Value="{DynamicResource BorderDefaultBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="{TemplateBinding Background}" Margin="{TemplateBinding Margin}"
                  SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ponytail: OmenWindow/OmenTabControl/OmenTabItem/OmenHeading/OmenSubHeading/OmenBody/
       OmenCaption/OmenStatValue/OmenStatUnit/OmenToolTip/OmenGroupCard/OmenProgressBar 0 引用已删除 -->

  <Style TargetType="Hyperlink">
    <Setter Property="Foreground" Value="{DynamicResource AccentOmenBrush}"/>
    <Setter Property="TextDecorations" Value="Underline"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource AccentOmenLightBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
