<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!-- ponytail: 显式锁定 Workstation GC + Concurrent —— 这是单实例常驻旁观工具工作集最小的配置。
         default behavior on net481, 但显式声明防止 OEM 镜像或未来框架升级静默开启 server GC
         (server GC 会增加多几十 MB 工作集,只为高并发吞吐场景,JIT 序列化对吞吐提升有限)。 -->
    <gcServer enabled="false" />
    <gcConcurrent enabled="true" />
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <!-- ponytail: 范围覆盖到 6.0.3.0 —— HP 链 STasks.Extensions 4.2.4.0 编译期引用 Unsafe 6.0.3.0，
             磁盘实际只有 6.0.0.0(Costura 嵌入)。旧范围只到 6.0.0.0 覆盖不到,一旦 HP 链走 6.0.3 API 会
             FileLoadException;加宽后 6.0.3.0 请求重定向到 6.0.0.0,堵住未触发的运行时隐患。 -->
        <bindingRedirect oldVersion="0.0.0.0-6.0.3.0" newVersion="6.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Diagnostics.DiagnosticSource" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.1.0" newVersion="4.0.1.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Extensions.ObjectPool" publicKeyToken="adb9793829ddae60" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="6.0.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <!-- ponytail: HP SDK(PerformanceControl)按 4.1.1.0 请求；落盘 4.2.4.0(见 Resources/)。
             该链必须走默认加载上下文(松散 dll,不嵌入 Costura)重定向才生效。 -->
        <bindingRedirect oldVersion="0.0.0.0-4.5.4.0" newVersion="4.2.4.0" />
      </dependentAssembly>
      <!-- Intel XTU SDK 的重定向: SDK 编译期引用的旧版本统一指向 Resources/ 实际版本
           (RpcClient 0.2.1→1.4.35, Logging 1.2/2.2.9→2.2.12, Newtonsoft 10→13) -->
      <dependentAssembly>
        <assemblyIdentity name="RpcClient" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.4.35.0" newVersion="1.4.35.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Logging" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.2.12.0" newVersion="2.2.12.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
