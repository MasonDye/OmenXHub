<ui:FluentWindow x:Class="OmenSuperHub.Views.SystemOptimizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:app="clr-namespace:OmenSuperHub"
        Title="{x:Static app:Strings.SysOptWindowTitle}" Width="680" Height="620"
        MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Background="Transparent">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Title area -->
    <Border Grid.Row="0"
            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
            Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="DialogTitle" Text="{x:Static app:Strings.SysOptWindowTitle}"
                   FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <ui:Button Grid.Column="1" x:Name="OneClickOptimizeBtn"
                   Content="{x:Static app:Strings.SysOptOneClick}"
                   Appearance="Primary" Height="30" Padding="12,0" Margin="0,0,8,0"
                   Click="OneClickOptimize_Click">
          <ui:Button.Icon>
            <ui:SymbolIcon Symbol="Wand24" FontSize="{DynamicResource FontSizeTitle}"/>
          </ui:Button.Icon>
        </ui:Button>
        <ui:Button Grid.Column="2" x:Name="RestoreBtn"
                   Content="{x:Static app:Strings.SysOptRestore}"
                   Appearance="Secondary" Height="30" Padding="12,0" Margin="0,0,8,0"
                   Click="RestoreBtn_Click">
          <ui:Button.Icon>
            <ui:SymbolIcon Symbol="ArrowReset24" FontSize="{DynamicResource FontSizeTitle}"/>
          </ui:Button.Icon>
        </ui:Button>
        <ui:Button Grid.Column="3" x:Name="RefreshBtn" Content="{x:Static app:Strings.SysOptRefresh}"
                   Appearance="Secondary" Height="30" Padding="10,0" Margin="0,0,8,0" Click="RefreshBtn_Click"/>
        <ui:Button Grid.Column="4" x:Name="CloseBtn" Appearance="Transparent" Height="30" Width="30"
                   Padding="0" Margin="0" Click="CloseBtn_Click"
                   ToolTip="{x:Static app:Strings.SysOptClose}">
          <ui:SymbolIcon Symbol="Dismiss24" FontSize="{DynamicResource FontSizeTitle}"/>
        </ui:Button>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" x:Name="MainTabs" Margin="12" SelectionChanged="TabControl_SelectionChanged">
      <!-- 服务 -->
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Server24" FontSize="{DynamicResource FontSizeTitle}" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="{x:Static app:Strings.SysOptServicesTab}"/>
          </StackPanel>
        </TabItem.Header>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="{x:Static app:Strings.SysOptServicesHint}" FontSize="{DynamicResource FontSizeCaption}"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,6"
                     TextWrapping="Wrap"/>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ServiceList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                          CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5" Margin="0,0,10,0"
                              VerticalAlignment="Center">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="#FFB900"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding State}" Value="Running">
                                <Setter Property="Background" Value="#4CC38A"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding State}" Value="Stopped">
                                <Setter Property="Background" Value="#6C6C6C"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                      </Border>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeCaption}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <ComboBox Grid.Column="2" Width="110" Margin="8,0,0,0" VerticalAlignment="Center"
                                IsEnabled="{Binding CanChange}"
                                SelectedIndex="{Binding StartupTypeIndex, Mode=OneWay}"
                                SelectionChanged="ServiceType_SelectionChanged"
                                Tag="{Binding}">
                        <ComboBoxItem Content="{x:Static app:Strings.SysOptStartupAuto}"/>
                        <ComboBoxItem Content="{x:Static app:Strings.SysOptStartupManual}"/>
                        <ComboBoxItem Content="{x:Static app:Strings.SysOptStartupDisabled}"/>
                      </ComboBox>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- 启动项 -->
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Power24" FontSize="{DynamicResource FontSizeTitle}" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="{x:Static app:Strings.SysOptStartupTab}"/>
          </StackPanel>
        </TabItem.Header>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="{x:Static app:Strings.SysOptStartupHint}" FontSize="{DynamicResource FontSizeCaption}"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,6"
                     TextWrapping="Wrap"/>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="StartupList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                          CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                          <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                  CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Location}" FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Command}" FontSize="{DynamicResource FontSizeCaption}" MaxWidth="420"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                      </StackPanel>
                      <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                       IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                       Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed"
                                       Tag="{Binding}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- 通用优化 -->
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Settings24" FontSize="{DynamicResource FontSizeTitle}" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="{x:Static app:Strings.SysOptTweaksTab}"/>
          </StackPanel>
        </TabItem.Header>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="{x:Static app:Strings.SysOptTweaksHint}" FontSize="{DynamicResource FontSizeCaption}"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,6"
                     TextWrapping="Wrap"/>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TweakList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                          CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis"/>
                          <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                  CornerRadius="6" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                  Visibility="{Binding RestartVisible}">
                            <TextBlock Text="{x:Static app:Strings.SysOptTweakNeedsRestart}" FontSize="{DynamicResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" FontSize="{DynamicResource FontSizeCaption}" MaxWidth="420"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding StateText}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold"
                                   Foreground="{Binding StateBrush}" Margin="0,2,0,0"/>
                      </StackPanel>
                      <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                       IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                       Checked="TweakToggle_Changed" Unchecked="TweakToggle_Changed"
                                       Tag="{Binding}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</ui:FluentWindow>
