<ui:FluentWindow x:Class="OmenSuperHub.Views.StorageCleanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:app="clr-namespace:OmenSuperHub"
        Title="{x:Static app:Strings.StorageCleanTitle}" Width="480" Height="560"
        MinWidth="420" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Background="Transparent">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Title -->
    <Border Grid.Row="0"
            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
            Padding="16,12">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ui:SymbolIcon Symbol="Broom24" FontSize="{DynamicResource FontSizeTitle}"
                         Foreground="{DynamicResource AccentOmenBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="{x:Static app:Strings.StorageCleanTitle}"
                     FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <ui:Button x:Name="CloseBtn" Appearance="Transparent" Height="30" Width="30" Padding="0"
                   HorizontalAlignment="Right" Click="CloseBtn_Click"
                   ToolTip="{x:Static app:Strings.SysOptClose}">
          <ui:SymbolIcon Symbol="Dismiss24" FontSize="{DynamicResource FontSizeTitle}"/>
        </ui:Button>
      </Grid>
    </Border>

    <!-- List -->
    <Grid Grid.Row="1" Margin="12,0,12,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid>
        <CheckBox x:Name="SelectAllBox" VerticalAlignment="Center" Padding="8,2"
                  Checked="SelectAll_Checked" Unchecked="SelectAll_Unchecked"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock x:Name="SelectedTotalText" VerticalAlignment="Center" Margin="0,0,10,0"
                     FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <ui:Button Content="{x:Static app:Strings.StorageCleanRescan}" Height="28" Padding="10,0"
                     x:Name="RescanBtn" Click="Rescan_Click"/>
        </StackPanel>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="ItemsList" Margin="0,4,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                      CornerRadius="6" Padding="12,10,12,10" Margin="0,0,0,6">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSubtitle}"/>
                    <TextBlock Text="{Binding Description}" FontSize="{DynamicResource FontSizeCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" MinWidth="70"
                             TextAlignment="Right" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSubtitle}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- Footer -->
    <Border Grid.Row="2"
            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
            Padding="16,10">
      <Grid>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <ui:Button x:Name="CleanBtn" Content="{x:Static app:Strings.StorageCleanRun}"
                   Appearance="Primary" HorizontalAlignment="Right" Height="32" Padding="14,0"
                   Click="CleanBtn_Click">
          <ui:Button.Icon>
            <ui:SymbolIcon Symbol="Delete24" FontSize="{DynamicResource FontSizeSubtitle}"/>
          </ui:Button.Icon>
        </ui:Button>
      </Grid>
    </Border>
  </Grid>
</ui:FluentWindow>
